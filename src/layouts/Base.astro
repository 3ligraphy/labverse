---
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import SearchPalette from '@/components/SearchPalette.astro';
import Announce from '@/components/Announce.astro';
import ModuleAnnounce from '@/components/ModuleAnnounce.astro';
import StaffBar from '@/components/platform/StaffBar.astro';
import StatusStrip from '@/components/StatusStrip.astro';
import { platform } from '@/site.config';
import '@/styles/global.css';

/** `module`: the builder module this page belongs to (its sections replace the course nav). */
/** `module.skin`: the module's design ('neon' = the futuristic AI for Coding look); sets data-skin on <html>. */
interface Props { title?: string; description?: string; noindex?: boolean; module?: { slug: string; title: string; color?: string; skin?: string } }
const { title, description = platform.tagline, noindex = false, module } = Astro.props;
const fullTitle = title ? `${title} · ${platform.name}` : `${platform.name} — ${platform.tagline}`;
const builtInCourse = /^\/mobile-development(\/|$)/.test(Astro.url.pathname);
// the admin workspace has its own menu and a Back button instead of the site navbar
const adminArea = /^\/admin(\/|$)/.test(Astro.url.pathname);
// inside a module the navbar has a second row with the module's sections (pages leave room for it via --nav-h)
const modbar = !adminArea && (Boolean(module) || builtInCourse);
// staff tools on module and lab pages (lock the labs, edit, progress, statistics), with this page's links
const page = Astro.url.pathname.replace(/\/$/, '');
const builderLab = module && page.startsWith(`/${module.slug}/`) ? page.slice(module.slug.length + 2) : '';
const courseLab = builtInCourse && /^\/mobile-development\/labs\/[^/]+$/.test(page);
const staffBar = adminArea ? null
  : module ? {
    module: module.slug, back: `/${module.slug}`, stats: `/admin/stats?module=${module.slug}`,
    edit: builderLab ? `/admin/builder/${module.slug}/${builderLab}` : `/admin/builder/${module.slug}`,
    progress: builderLab ? `/admin/progress?lab=${module.slug}--${builderLab}` : `/admin/progress?module=${module.slug}`,
  }
  : builtInCourse ? { module: 'mobile-development', back: '/mobile-development/labs', edit: '/admin/cms', progress: '/admin/progress?module=mobile-development', stats: '/admin/stats?module=mobile-development', overlay: courseLab }
  : null;
---
<!doctype html>
<html lang="en" class:list={['no-js', { 'no-site-nav': adminArea, 'has-modbar': modbar }]} data-skin={module?.skin || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0c0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4ef" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
    />
    {module?.skin === 'neon' && (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=JetBrains+Mono:wght@400..700&display=swap" />
    )}
    <script is:inline>
      // Theme before paint (no flash). Re-applied after each client-side navigation.
      (function () {
        function apply() {
          var t = null;
          try { t = localStorage.getItem('theme'); } catch (e) {}
          if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = t;
          document.documentElement.classList.remove('no-js');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <script is:inline>
      // "Saving is off": while the course database is down (GET /api/status), <html> gets `db-down`. That shows the
      // strip under the navbar (StatusStrip.astro) and makes room for it (--nav-h). The last answer is kept in this
      // tab for a short time, so every page shows it before paint; it is asked again when it is old.
      (function () {
        if (window.__buenovaDb) return;
        window.__buenovaDb = true;
        var KEY = 'buenova:db';
        var asking = false;
        function read() { try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
        function apply(s) { document.documentElement.classList.toggle('db-down', Boolean(s && s.down)); }
        function check() {
          var s = read();
          apply(s);
          if (asking || (s && Date.now() - s.at < (s.down ? 20000 : 120000))) return;
          asking = true;
          fetch('/api/status').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
            if (!d) return;
            var next = { down: d.database === 'down', at: Date.now() };
            try { sessionStorage.setItem(KEY, JSON.stringify(next)); } catch (e) {}
            apply(next);
            if (Boolean(s && s.down) !== next.down) window.dispatchEvent(new CustomEvent('buenova:db', { detail: next }));
          }).catch(function () {}).then(function () { asking = false; });
        }
        check();
        document.addEventListener('astro:after-swap', check);
        // ask again now and then (every 30 s while it is down, every 2 min otherwise), so the strip comes and goes by itself
        setInterval(function () { if (document.visibilityState === 'visible') check(); }, 30000);
        // the strip's "What this means" button: opens the short list, closes on Escape or a click elsewhere
        function close(focus) {
          var more = document.getElementById('dbs-more');
          var btn = document.querySelector('[data-dbs-toggle]');
          if (!more || more.hidden) return;
          more.hidden = true;
          if (btn) { btn.setAttribute('aria-expanded', 'false'); if (focus) btn.focus(); }
        }
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          var btn = t && t.closest('[data-dbs-toggle]');
          var more = document.getElementById('dbs-more');
          if (btn && more) { more.hidden = !more.hidden; btn.setAttribute('aria-expanded', String(!more.hidden)); return; }
          if (!(t && t.closest('#dbs-more'))) close(false);
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(true); });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!adminArea && <Nav module={module} />}
    <StatusStrip />
    <main id="main" tabindex="-1" transition:name="main">
      <slot />
    </main>
    <Footer />
    <SearchPalette indexUrl={module ? `/api/search?module=${encodeURIComponent(module.slug)}${Astro.url.searchParams.has('preview') ? '&preview' : ''}` : builtInCourse ? '/search-index.json' : '/api/search'} label={module?.title ?? (builtInCourse ? 'Mobile Development' : 'the platform')} />
    {builtInCourse && <Announce />}
    {builtInCourse && <ModuleAnnounce module="mobile-development" color="#c8ff4d" />}
    {module && <ModuleAnnounce module={module.slug} color={module.color} />}
    {staffBar && <StaffBar {...staffBar} />}
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
