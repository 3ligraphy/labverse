---
/**
 * Lab 07 · Part 2 — Expo Go or your own build: Expo Go is one app (from the store) that runs any project's
 * JavaScript sent by your computer, with its own native code and settings; your own build is your app file, with
 * your app.json settings, that runs without your computer. <ExpoGoBuild />
 */
import Stepper from './Stepper.astro';

const logoFiles = import.meta.glob<ImageMetadata>('/src/assets/tools/*.svg', { eager: true, import: 'default' });
const expo = logoFiles['/src/assets/tools/expo.svg']?.src;

const STEPS = [
  { title: 'Expo Go: one app for every project', text: '**Expo Go** is an app from the store. It already has many native packages inside — the camera and haptics too. It does not know your project yet.', ms: 4600 },
  { title: 'Your JavaScript comes from your computer', text: '`npx expo start` serves your JavaScript. Expo Go downloads it and runs it, and reloads it in a second when you save a file (**Fast Refresh**). Your computer must stay on, on the same network.', ms: 5600 },
  { title: 'Not your app.json settings', text: 'Expo Go was built long ago, with **its own** name, icon and permission texts. Your `app.json` settings and plugins are not used — that is why the camera dialog says “Expo Go”.', ms: 5600 },
  { title: 'Your own build: your app file', text: '**EAS Build** turns your project into your own app file (an APK on Android): your name, your icon, your permission text, the native packages you chose. It runs **without** your computer.', ms: 5600 },
  { title: 'Change it later: update or new build', text: 'New JavaScript (a text, a style, a bug fix) can reach your build with **EAS Update**. A new native package, permission text or icon needs a **new build** (Part 8).', ms: 5200 },
];
---
<Stepper label="Expo Go or your own build?" steps={STEPS} class="eg">
  <div class="eg-grid">
    <div class="eg-pc stp-only" data-at="2-3:show 4-5:show">
      <span class="eg-k mono">your computer</span>
      <code class="eg-cmd" data-at="2-3:on">$ npx expo start</code>
      <code class="eg-cmd eg-eas" data-at="4-5:on">$ eas build</code>
      <span class="eg-files mono"><i>App.tsx</i><i>src/…</i><i class="eg-appjson" data-at="3:no 4:yes">app.json</i></span>
    </div>

    <div class="eg-arrows" aria-hidden="true">
      <span class="eg-arrow stp-only" data-at="2:show">JavaScript →</span>
      <span class="eg-arrow eg-bad stp-only" data-at="3:show">app.json ✕</span>
      <span class="eg-arrow stp-only" data-at="4:show">app file (APK) →</span>
      <span class="eg-arrow stp-only" data-at="5:show">eas update →</span>
    </div>

    <div class="eg-phones">
      <div class="eg-phone" data-at="1-3:on 4-5:dim">
        <span class="eg-icon eg-go">{expo && <img src={expo} alt="" width="22" height="22" />}</span>
        <b>Expo Go</b>
        <small>one app from the store</small>
        <span class="eg-tags">
          <span class="eg-tag stp-only" data-at="2:show">runs your JavaScript</span>
          <span class="eg-tag eg-tag-bad stp-only" data-at="3:show">dialog: “Allow <b>Expo Go</b> …”</span>
        </span>
      </div>
      <div class="eg-phone eg-own stp-only" data-at="4-5:show">
        <span class="eg-icon eg-qr">QR</span>
        <b>Smart QR</b>
        <small>your own app file</small>
        <span class="eg-tags">
          <span class="eg-tag stp-only" data-at="4:show">your name, icon, permission text</span>
          <span class="eg-tag stp-only" data-at="5:show">JS → update · native → new build</span>
        </span>
      </div>
    </div>
  </div>
</Stepper>

<style>
  .eg-grid { display: grid; gap: 14px; align-items: center; }
  @media (min-width: 820px) { .eg-grid { grid-template-columns: minmax(0, 1fr) 150px minmax(0, 1.2fr); } }
  .eg-pc { display: grid; gap: 8px; padding: 14px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg-2); }
  .eg-k { font-size: 12px; font-weight: 700; color: var(--text-2); }
  .eg-cmd { justify-self: start; padding: 5px 10px; border-radius: 8px; background: #0b0f17; color: #e2e8f0; font-size: 12.5px; opacity: 0.45; transition: opacity 0.3s; }
  .eg-cmd[data-now='on'] { opacity: 1; box-shadow: 0 0 0 2px var(--accent); }
  .eg-files { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; }
  .eg-files i { font-style: normal; padding: 3px 8px; border-radius: 6px; background: var(--surface); border: 1px solid var(--line); color: var(--text); }
  .eg-appjson[data-now='no'] { text-decoration: line-through; color: var(--danger); border-color: var(--danger); }
  .eg-appjson[data-now='yes'] { border-color: var(--ok); color: var(--ok); }
  .eg-arrows { display: grid; justify-items: center; }
  .eg-arrows > span { grid-area: 1 / 1; }
  .eg-arrow { padding: 5px 10px; border-radius: 999px; background: color-mix(in oklab, var(--accent) 16%, transparent); color: var(--text); font: 700 12.5px var(--font-mono); white-space: nowrap; }
  .eg-bad { background: color-mix(in oklab, var(--danger) 16%, transparent); }
  .eg-phones { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .eg-phone { display: grid; justify-items: center; align-content: start; gap: 6px; width: 170px; min-height: 230px; padding: 22px 12px; border-radius: 26px; background: #0f172a; color: #e2e8f0; text-align: center; box-shadow: inset 0 0 0 6px #0b0f17, 0 14px 30px -20px rgb(0 0 0 / 0.6); transition: opacity 0.35s; }
  .eg-phone[data-now='dim'] { opacity: 0.45; }
  .eg-phone b { font-size: 15px; color: #fff; }
  .eg-phone small { font-size: 12px; color: #94a3b8; }
  .eg-icon { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 13px; margin-bottom: 4px; }
  .eg-go { background: #fff; }
  .eg-qr { background: #0f172a; box-shadow: inset 0 0 0 3px #38bdf8; color: #38bdf8; font-weight: 800; }
  .eg-tag { padding: 5px 9px; border-radius: 10px; background: rgb(56 189 248 / 0.16); color: #e2e8f0; font-size: 12px; line-height: 1.4; }
  .eg-tag-bad { background: rgb(248 113 113 / 0.18); }
  .eg-tags { display: grid; margin-top: 6px; }
  .eg-tags > span { grid-area: 1 / 1; }
</style>
