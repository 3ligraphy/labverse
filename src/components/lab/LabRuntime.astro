---
/**
 * The lab page's client runtime, shared by file-based labs (/mobile-development/labs/[id]) and builder labs (/[module]/[lab]):
 * Done ticks (saved per lab in this browser and reported to the TA), the progress ring, tracker and plan
 * fills, the completion banner, legend highlighting, and the progress UI (identity sheet, queue, check-in).
 * Reads the lab id from the [data-lab] element.
 */
---
<script>
  import { onPageLoad } from '@/scripts/page-load';
  import { ensureIdentity, initProgressUi, record } from '@/scripts/progress';

  /* Task progress (saved per lab in this browser) + legend ↔ marker highlighting */
  function init() {
    const root = document.querySelector<HTMLElement>('[data-lab]');
    if (!root) return;
    legends();
    // interactive labs track solved exercises themselves (src/lab/ui/progress.ts)
    if (root.hasAttribute('data-lab-interactive')) return;
    const key = `lab-progress:${root.dataset.lab}`;
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-task-check]'));
    const total = boxes.length;
    let done = new Set<string>();
    try { done = new Set(JSON.parse(localStorage.getItem(key) || '[]')); } catch {}
    boxes.forEach((b) => (b.checked = done.has(b.value)));

    const update = () => {
      const n = boxes.filter((b) => b.checked).length;
      const p = total ? n / total : 0;
      boxes.forEach((b) => b.closest('.task')?.classList.toggle('is-done', b.checked));
      document.querySelectorAll<HTMLAnchorElement>('[data-track]').forEach((a) => a.classList.toggle('done', done.has(a.dataset.track!)));
      const ring = document.querySelector<SVGCircleElement>('[data-ring]');
      if (ring) ring.style.strokeDashoffset = String(100 - p * 100);
      const pct = document.querySelector('[data-pct]');
      if (pct) pct.textContent = String(Math.round(p * 100));
      const dn = document.querySelector('[data-done]');
      if (dn) dn.textContent = String(n);
      document.querySelector<HTMLElement>('[data-track-bar]')?.style.setProperty('--p', String(p));
      // per-part fill in the session plan
      document.querySelectorAll<HTMLAnchorElement>('[data-plan-part]').forEach((a) => {
        const part = a.dataset.planPart!;
        const inPart = boxes.filter((b) => b.value.split('.')[0] === part);
        const pd = inPart.filter((b) => b.checked).length;
        a.style.setProperty('--p', String(inPart.length ? pd / inPart.length : 0));
      });
      const banner = document.querySelector<HTMLElement>('[data-lab-complete]');
      if (banner) banner.hidden = !(total && n === total);
    };
    boxes.forEach((b) =>
      b.addEventListener('change', () => {
        b.checked ? done.add(b.value) : done.delete(b.value);
        try { localStorage.setItem(key, JSON.stringify([...done])); } catch {}
        update();
        // progress tracking: the TA sees Done ticks (asks for name + ID the first time)
        ensureIdentity().then((me) => me && record.task({ lab: root.dataset.lab!, task: b.value, done: b.checked }));
      }),
    );
    // "reset" clears every Done tick (here and for the TA), so it asks first: a second click within 5 s clears them,
    // and for 8 s after that the same button says "undo" and puts them all back.
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-lab-reset]');
    if (resetBtn) {
      const label = resetBtn.textContent || 'reset';
      let state: 'idle' | 'confirm' | 'undo' = 'idle';
      let timer = 0;
      let cleared: string[] = [];
      const idle = () => { window.clearTimeout(timer); state = 'idle'; cleared = []; resetBtn.textContent = label; };
      const save = () => { try { localStorage.setItem(key, JSON.stringify([...done])); } catch {} };
      resetBtn.addEventListener('click', () => {
        const ticked = boxes.filter((b) => b.checked);
        if (state === 'undo') {
          for (const value of cleared) {
            done.add(value);
            const box = boxes.find((b) => b.value === value);
            if (box) box.checked = true;
            record.task({ lab: root.dataset.lab!, task: value, done: true });
          }
          save();
          update();
          return idle();
        }
        if (!ticked.length) return;
        if (state === 'idle') {
          state = 'confirm';
          resetBtn.textContent = `clear ${ticked.length} tick${ticked.length === 1 ? '' : 's'}? click again`;
          timer = window.setTimeout(idle, 5000);
          return;
        }
        window.clearTimeout(timer);
        cleared = ticked.map((b) => b.value);
        cleared.forEach((task) => record.task({ lab: root.dataset.lab!, task, done: false }));
        done.clear();
        boxes.forEach((b) => (b.checked = false));
        try { localStorage.removeItem(key); } catch {}
        update();
        state = 'undo';
        resetBtn.textContent = 'cleared · undo';
        timer = window.setTimeout(idle, 8000);
      });
    }
    update();
  }

  /** "Hide tracker" / floating "Tracker" button: collapses the right-hand nav so the content re-centers wider. */
  function trackerToggle() {
    const doc = document.querySelector<HTMLElement>('.doc');
    // interactive labs (02/03): .doc-aside IS the exercise tracker, not an optional ToC — never touch it here
    if (!doc || doc.classList.contains('is-interactive')) return;
    const hideBtn = document.querySelector<HTMLButtonElement>('[data-tracker-hide]');
    const showBtn = document.querySelector<HTMLButtonElement>('[data-tracker-show]');
    if (!hideBtn || !showBtn) return;
    const KEY = 'lab-tracker-hidden';
    const set = (hidden: boolean) => {
      doc.classList.toggle('tracker-hidden', hidden);
      try { localStorage.setItem(KEY, hidden ? '1' : '0'); } catch {}
    };
    set(localStorage.getItem(KEY) === '1');
    hideBtn.addEventListener('click', () => set(true));
    showBtn.addEventListener('click', () => set(false));
  }

  /** hovering a legend item highlights the matching numbered marker (and vice versa) */
  function legends() {
    document.querySelectorAll<HTMLOListElement>('.mock-fig + ol, .legend-host + ol').forEach((ol) => {
      const fig = ol.previousElementSibling;
      if (!fig) return;
      const marks = Array.from(fig.querySelectorAll<HTMLElement>('.mk'));
      Array.from(ol.children).forEach((li, i) => {
        const mk = marks.find((m) => m.textContent?.trim() === String(i + 1));
        if (!mk) return;
        const on = () => { mk.classList.add('hl'); li.classList.add('hl'); };
        const off = () => { mk.classList.remove('hl'); li.classList.remove('hl'); };
        li.addEventListener('mouseenter', on); li.addEventListener('mouseleave', off);
        mk.addEventListener('mouseenter', on); mk.addEventListener('mouseleave', off);
      });
    });
  }
  onPageLoad( init);
  onPageLoad( initProgressUi);
  onPageLoad( trackerToggle);
</script>
