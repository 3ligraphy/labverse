---
/**
 * "You should now see…" box: a milestone in the lab text, not a status. It cannot know whether the student got there,
 * so it never looks "done": a neutral flag (no green tick), always labelled Checkpoint, then its title.
 * <Checkpoint title="…"> …markdown… </Checkpoint>
 */
interface Props { title?: string }
const { title } = Astro.props;
const name = title && title.trim().toLowerCase() !== 'checkpoint' ? title.trim() : '';
---
<div class="cp" role="note" aria-label={name ? `Checkpoint: ${name}` : 'Checkpoint'} data-reveal>
  <span class="cp-ic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4" /><path d="M5 4h12l-2.5 4.5L17 13H5" /></svg>
  </span>
  <div class="cp-body">
    <p class="cp-title"><span class="cp-k mono">Checkpoint</span>{name && <span class="cp-name">{name}</span>}</p>
    <slot />
  </div>
</div>

<style>
  .cp { display: grid; grid-template-columns: 36px 1fr; gap: 14px; padding: 16px 18px; border-radius: var(--r-md); border: 1px solid var(--line-2); background: var(--surface); }
  .cp-ic { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-3); color: var(--text-2); }
  .cp-ic svg { width: 18px; height: 18px; }
  .cp-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin-bottom: 4px; }
  .cp-k { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-2); font-weight: 600; }
  .cp-name { font-weight: 650; color: var(--text); }
  .cp-body { color: var(--text); min-width: 0; }
  .cp-body > :global(* + *) { margin-top: 12px !important; }
</style>
