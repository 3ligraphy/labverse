---
/**
 * The admin workspace frame: a role-aware sidebar (each item appears only with its permission; the super admin
 * and the master password see everything) around the page. Generic across modules — module-specific tools are
 * reached from the workspace home.
 */
import { access } from '@/lib/accounts/access';
import { hubData } from '@/lib/accounts/hub';
import { ROLE_NAMES } from '@/lib/accounts/permissions';
import { platform } from '@/site.config';
import Logo from '@/components/Logo.astro';

interface Props { active?: string }
const { active = '' } = Astro.props;
const a = await access(Astro.cookies);
const modules = Object.keys(a.who.modules);
const teachingModules = (await hubData()).cards
  .filter((module) => modules.includes(module.slug))
  .map((module) => ({ slug: module.slug, title: module.title, code: module.code, color: module.color, role: ROLE_NAMES[a.who.modules[module.slug]] }));
const any = (p: Parameters<typeof a.can>[0]) => a.can(p) || modules.some((m) => a.can(p, m));
const groups = [
  { title: 'Workspace', items: [{ key: 'home', label: 'Home', href: '/admin', icon: '◎', show: true }] },
  { title: 'Teaching', items: [
    { key: 'sessions', label: 'Sessions & attendance', href: '/admin/sessions', icon: '◷', show: any('module.sessions') || any('module.progress') },
    { key: 'progress', label: 'Lab progress', href: '/admin/progress', icon: '▤', show: any('module.progress') },
    { key: 'submissions', label: 'Project submissions', href: '/admin/project', icon: '⇪', show: a.can('module.submissions', 'mobile-development') },
  ] },
  { title: 'Modules', items: [
    { key: 'builder', label: 'Modules & lab builder', href: '/admin/builder', icon: '⬡', show: a.can('modules.create') || any('module.build') },
    { key: 'teams', label: 'Teams & invitations', href: '/admin/teams', icon: '✉', show: any('module.invite') },
  ] },
  { title: 'Platform', items: [
    { key: 'catalogue', label: 'Catalogue', href: '/admin/catalogue', icon: '▦', show: a.can('platform.settings') },
    { key: 'accounts', label: 'Accounts & roles', href: '/admin/accounts', icon: '⚿', show: a.can('accounts.manage') || a.can('accounts.staff') || a.can('platform.roles') },
    { key: 'cms', label: 'Course content (CMS)', href: '/admin/cms', icon: '✎', show: a.can('cms.edit') },
  ] },
].map((g) => ({ ...g, items: g.items.filter((i) => i.show) })).filter((g) => g.items.length);
const who = a.user?.name ?? (a.master ? 'Admin password' : 'Staff');
const role = a.who.platformRole ? ROLE_NAMES[a.who.platformRole] : a.master ? 'Full access' : '';
const initials = who.split(/\s+/).map((p) => p[0]).slice(0, 2).join('');
/** Phones: the first four tools in a bottom tab bar (always including the current one), the rest under More. */
const allItems = groups.flatMap((g) => g.items);
const current = allItems.find((i) => i.key === active);
const tabItems = allItems.slice(0, 4);
if (current && !tabItems.includes(current)) tabItems[3] = current;
const short: Record<string, string> = { home: 'Home', sessions: 'Sessions', progress: 'Progress', submissions: 'Projects', builder: 'Builder', teams: 'Teams', catalogue: 'Catalogue', accounts: 'Accounts', cms: 'CMS' };
---
<div class="ash">
  <aside class="ash-side" aria-label="Admin">
    <a class="ash-brand" href="/admin"><Logo size={34} /><span><b>{platform.name}</b><small class="mono">admin workspace</small></span></a>
    <div class="ash-me">
      <span class="ash-av" aria-hidden="true">{initials}</span>
      <span><b>{who}</b><small class="mono">{role}{modules.length ? ` · ${modules.length} module${modules.length === 1 ? '' : 's'}` : ''}</small></span>
    </div>
    <nav class="ash-nav">
      {groups.map((g) => (
        <div class="ash-group">
          {g.title === 'Teaching' && teachingModules.length ? (
            <>
              <button class="ash-gt ash-toggle mono" type="button" data-ash-teaching aria-expanded="false" aria-controls="ash-teaching-modules">
                <span>Teaching</span><span class="ash-chevron" aria-hidden="true">⌄</span>
              </button>
              <div class="ash-module-menu" id="ash-teaching-modules" data-ash-teaching-modules hidden>
                {teachingModules.map((module) => (
                  <a href={`/admin#module-${module.slug}`} style={`--mc:${module.color}`}>
                    <span class="ash-module-dot" aria-hidden="true"></span>
                    <span><b>{module.title}</b><small>{module.code || 'Module'} · {module.role}</small></span>
                  </a>
                ))}
              </div>
            </>
          ) : <p class="ash-gt mono">{g.title}</p>}
          {g.items.map((i) => <a class:list={['ash-link', { on: i.key === active }]} href={i.href} aria-current={i.key === active ? 'page' : undefined}><span class="ash-ic" aria-hidden="true">{i.icon}</span>{i.label}</a>)}
        </div>
      ))}
    </nav>
    <div class="ash-foot">
      <a href="/account">My profile</a>
      <a href="/" target="_blank" rel="noopener">View site ↗</a>
      <button type="button" data-ash-out>Sign out</button>
    </div>
  </aside>
  <div class="ash-main"><slot /></div>

  <nav class="ash-tabbar" aria-label="Admin sections">
    {tabItems.map((i) => <a class="ash-tab" href={i.href} aria-current={i.key === active ? 'page' : undefined}><span class="ash-ic" aria-hidden="true">{i.icon}</span>{short[i.key] ?? i.label}</a>)}
    <button type="button" class="ash-tab" data-ash-more aria-expanded="false" aria-controls="ash-more"><span class="ash-ic" aria-hidden="true">⋯</span>More</button>
  </nav>
  <div class="ash-scrim" data-ash-scrim hidden></div>
  <div class="ash-sheet" id="ash-more" data-ash-sheet hidden role="dialog" aria-label="Admin menu">
    <div class="ash-sheet-head"><span class="ash-grab" aria-hidden="true"></span><b>Admin workspace</b><button type="button" class="ash-x" data-ash-close aria-label="Close">✕</button></div>
    <div class="ash-me">
      <span class="ash-av" aria-hidden="true">{initials}</span>
      <span><b>{who}</b><small class="mono">{role}{modules.length ? ` · ${modules.length} module${modules.length === 1 ? '' : 's'}` : ''}</small></span>
    </div>
    {groups.map((g) => (
      <div class="ash-sheet-group">
        <p class="ash-gt mono">{g.title}</p>
        <div class="ash-sheet-grid">
          {g.items.map((i) => <a class:list={['ash-sheet-item', { on: i.key === active }]} href={i.href}><span class="ash-ic" aria-hidden="true">{i.icon}</span>{i.label}</a>)}
        </div>
      </div>
    ))}
    <div class="ash-sheet-foot">
      <a href="/account">My profile</a>
      <a href="/" target="_blank" rel="noopener">View site ↗</a>
      <button type="button" data-ash-out>Sign out</button>
    </div>
  </div>
</div>

<style is:global>
  .ash { --side: 264px; display: grid; min-height: 100dvh; background:
    radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 40%),
    radial-gradient(circle at 0% 100%, color-mix(in oklab, #7cb1ff 10%, transparent), transparent 40%), var(--bg); }
  @media (min-width: 1100px) { .ash { grid-template-columns: var(--side) minmax(0, 1fr); } }
  .ash-side { display: grid; align-content: start; gap: 18px; padding: calc(var(--nav-h) + 22px) 16px 22px; border-right: 1px solid var(--line); background: color-mix(in oklab, var(--surface) 70%, transparent); backdrop-filter: blur(16px); }
  @media (min-width: 1100px) { .ash-side { position: sticky; top: 0; height: 100dvh; overflow: auto; } }
  .ash-brand { display: flex; align-items: center; gap: 10px; }
  .ash-brand b { display: block; font-family: var(--font-display); letter-spacing: -.02em; }
  .ash-brand small, .ash-me small { display: block; font-size: 12px; color: var(--text-3); letter-spacing: .06em; }
  .ash-me { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--line-2); background: var(--surface); }
  .ash-me b { display: block; font-size: 13.5px; }
  .ash-av { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; background: color-mix(in oklab, var(--accent) 25%, var(--surface-2)); color: var(--text); font: 700 12px var(--font-mono); flex: none; }
  .ash-group { display: grid; gap: 2px; margin-bottom: 10px; }
  .ash-gt { padding: 4px 10px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); }
  .ash-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; border: 0; background: none; cursor: pointer; text-align: left; }
  .ash-toggle:hover { color: var(--text); }
  .ash-chevron { font-size: 15px; transition: transform var(--t-fast); }
  .ash-toggle[aria-expanded='true'] .ash-chevron { transform: rotate(180deg); }
  .ash-module-menu { display: grid; gap: 3px; padding: 4px 0 7px; }
  .ash-module-menu[hidden] { display: none; }
  .ash-module-menu a { display: grid; grid-template-columns: 8px 1fr; gap: 9px; align-items: center; padding: 8px 10px; border-radius: 10px; color: var(--text-2); background: color-mix(in oklab, var(--surface-2) 65%, transparent); }
  .ash-module-menu a:hover { color: var(--text); background: var(--surface-2); }
  .ash-module-menu b, .ash-module-menu small { display: block; }
  .ash-module-menu b { font-size: 12.5px; }
  .ash-module-menu small { margin-top: 2px; color: var(--text-3); font: 10px var(--font-mono); }
  .ash-module-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mc); box-shadow: 0 0 9px var(--mc); }
  .ash-link { position: relative; display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px; font-size: 13.5px; color: var(--text-2); transition: background var(--t-fast), color var(--t-fast); }
  .ash-link:hover { background: var(--surface-2); color: var(--text); }
  .ash-link.on { color: var(--text); background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 18%, transparent), transparent); }
  .ash-link.on::before { content: ''; position: absolute; left: -16px; top: 8px; bottom: 8px; width: 3px; border-radius: 3px; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .ash-ic { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: var(--surface-2); font-size: 12px; color: var(--accent-text); flex: none; }
  .ash-link.on .ash-ic { background: var(--accent); color: var(--accent-ink); }
  .ash-foot { display: grid; gap: 4px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12.5px; }
  .ash-foot a, .ash-foot button { padding: 6px 10px; border-radius: 8px; color: var(--text-3); text-align: left; background: none; border: 0; cursor: pointer; font: inherit; }
  .ash-foot a:hover, .ash-foot button:hover { color: var(--text); background: var(--surface-2); }
  .ash-main { min-width: 0; }
  body:has(.ash) .footer { display: none; }
  /* pages inside the shell: no extra top gap on desktop beside the sidebar */
  .ash-main > :first-child { padding-left: clamp(16px, 3vw, 40px) !important; padding-right: clamp(16px, 3vw, 40px) !important; max-width: 1400px; margin-inline: 0; }
  /* shared admin look: frosted cards with a soft gradient rim */
  .ash-main :is(.adm-card, .ac-card, .bh-card, .tm-card, .pf-card, .si-card, .gp-card, .as-card, .ss, .bh-mod, .cat-card) {
    background: linear-gradient(180deg, color-mix(in oklab, var(--surface) 92%, transparent), color-mix(in oklab, var(--surface) 80%, transparent));
    border-color: color-mix(in oklab, var(--line-2) 80%, transparent); box-shadow: 0 1px 0 color-mix(in oklab, var(--text) 5%, transparent) inset, 0 20px 50px -34px rgb(0 0 0 / .45);
    backdrop-filter: blur(10px); }
  /* tablets: the menu row sits above the page, so the page doesn't need its own clearance for the header */
  @media (max-width: 1099px) { .ash-main > :first-child { padding-top: 24px !important; } }

  /* phones: an app layout — bottom tab bar + "More" sheet instead of the menu row */
  .ash-tabbar, .ash-scrim, .ash-sheet { display: none; }
  @media (max-width: 719px) {
    .ash-side { display: none; }
    .ash-main > :first-child { padding-top: calc(var(--nav-h) + 18px) !important; padding-bottom: calc(96px + env(safe-area-inset-bottom)) !important; }
    .ash-tabbar { position: fixed; z-index: 95; left: 0; right: 0; bottom: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
      padding: 6px 6px calc(env(safe-area-inset-bottom) + 6px); background: color-mix(in oklab, var(--surface) 92%, transparent); border-top: 1px solid var(--line); backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); }
    .ash-tab { position: relative; display: grid; justify-items: center; gap: 3px; padding: 5px 0 3px; border: 0; background: none; color: var(--text-3); font: 600 12px var(--font-body); -webkit-tap-highlight-color: transparent; }
    .ash-tab .ash-ic { width: 28px; height: 28px; border-radius: 9px; font-size: 13px; }
    .ash-tab[aria-current='page'] { color: var(--text); }
    .ash-tab[aria-current='page'] .ash-ic { background: var(--accent); color: var(--accent-ink); box-shadow: 0 6px 16px -6px var(--accent-glow); }
    .ash-tab:active { transform: scale(.94); }
    .ash-scrim:not([hidden]) { display: block; position: fixed; inset: 0; z-index: 110; background: rgb(5 8 12 / .45); backdrop-filter: blur(2px); }
    .ash-sheet:not([hidden]) { display: grid; gap: 14px; position: fixed; z-index: 111; left: 0; right: 0; bottom: 0; max-height: 86dvh; overflow: auto; padding: 0 16px calc(env(safe-area-inset-bottom) + 18px);
      border-radius: 22px 22px 0 0; background: var(--surface); box-shadow: 0 -20px 60px -20px rgb(0 0 0 / .5); animation: ash-up .28s cubic-bezier(.2,.8,.2,1); }
    @keyframes ash-up { from { transform: translateY(100%); } }
    /* <main> is its own stacking layer (page transitions), so the sheet can't rise above the fixed header: lower the header instead */
    body:has([data-ash-sheet]:not([hidden])) .nav { z-index: 0; }
    .ash-sheet-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin: 0 -16px; padding: 18px 16px 10px; background: var(--surface); border-bottom: 1px solid var(--line); }
    .ash-sheet-head b { font-size: 16px; }
    .ash-grab { position: absolute; left: 50%; top: 7px; width: 40px; height: 5px; margin-left: -20px; border-radius: 99px; background: var(--line-2); }
    .ash-x { width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--surface-2); color: var(--text-2); }
    .ash-sheet > * { grid-area: auto; min-width: 0; } /* the tablet rules name grid areas for the sidebar's copies */
    .ash-sheet .ash-gt { display: block !important; padding: 0 2px; }
    .ash-sheet .ash-me { grid-area: auto; padding: 10px 12px; }
    .ash-sheet-group { display: grid; gap: 6px; }
    .ash-sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .ash-sheet-item { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 10px; border-radius: 14px; border: 1px solid var(--line-2); background: var(--bg); color: var(--text); font-size: 13px; font-weight: 600; line-height: 1.25; }
    .ash-sheet-item.on { border-color: var(--accent-text); background: var(--accent-soft); }
    .ash-sheet-item.on .ash-ic { background: var(--accent); color: var(--accent-ink); }
    .ash-sheet-foot { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .ash-sheet-foot a, .ash-sheet-foot button { display: grid; place-items: center; min-height: 44px; border-radius: 12px; border: 1px solid var(--line-2); background: none; color: var(--text-2); font: 600 12.5px var(--font-body); }
    .ash-sheet-foot button { color: var(--danger); }
  }
  .ash-main :is(h1) { background: linear-gradient(100deg, var(--text) 40%, color-mix(in oklab, var(--accent-text) 80%, var(--text))); -webkit-background-clip: text; background-clip: text; color: transparent; }
  /* phones and tablets: who's signed in + profile/sign out on one row, the menu as a swipeable row of pills.
     Kept after the desktop rules so it wins over them. */
  @media (max-width: 1099px) {
    .ash-side { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "me foot" "nav nav"; align-items: center; gap: 10px;
      padding: calc(var(--nav-h) + 12px) 16px 12px; border-right: 0; border-bottom: 1px solid var(--line); }
    .ash-brand, .ash-gt, .ash-module-menu, .ash-foot a[target] { display: none !important; }
    .ash-me { grid-area: me; min-width: 0; padding: 8px 10px; }
    .ash-me > span:last-child { min-width: 0; }
    .ash-me b, .ash-me small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ash-av { width: 30px; height: 30px; border-radius: 9px; font-size: 12px; }
    .ash-foot { grid-area: foot; display: flex; gap: 4px; padding-top: 0; border-top: 0; }
    .ash-foot a, .ash-foot button { padding: 8px 10px; border: 1px solid var(--line-2); border-radius: 999px; white-space: nowrap; color: var(--text-2); }
    .ash-nav { grid-area: nav; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; }
    .ash-nav::-webkit-scrollbar { display: none; }
    .ash-nav .ash-group { display: contents; }
    .ash-link { flex: none; white-space: nowrap; padding: 6px 12px 6px 6px; border: 1px solid var(--line-2); border-radius: 999px; background: var(--surface); }
    .ash-link.on { border-color: color-mix(in oklab, var(--accent-text) 60%, transparent); background: var(--accent-soft); }
    .ash-link.on::before { display: none; }
  }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  onPageLoad( () => {
    const teaching = document.querySelector<HTMLButtonElement>('[data-ash-teaching]');
    const teachingModules = document.querySelector<HTMLElement>('[data-ash-teaching-modules]');
    if (teaching && teachingModules && !teaching.dataset.wired) {
      teaching.dataset.wired = '1';
      teaching.addEventListener('click', () => {
        const open = teaching.getAttribute('aria-expanded') !== 'true';
        teaching.setAttribute('aria-expanded', String(open));
        teachingModules.hidden = !open;
      });
    }
    // Phones: scroll the menu row so the current page's pill is visible (without moving the page).
    const nav = document.querySelector<HTMLElement>('.ash-nav');
    const on = nav?.querySelector<HTMLElement>('.ash-link.on');
    if (nav && on && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = on.offsetLeft - nav.offsetLeft - 16;
    // phones: the "More" sheet
    const more = document.querySelector<HTMLButtonElement>('[data-ash-more]');
    const sheet = document.querySelector<HTMLElement>('[data-ash-sheet]');
    const scrim = document.querySelector<HTMLElement>('[data-ash-scrim]');
    if (more && sheet && scrim && !more.dataset.wired) {
      more.dataset.wired = '1';
      const show = (open: boolean) => { sheet.hidden = !open; scrim.hidden = !open; more.setAttribute('aria-expanded', String(open)); document.body.style.overflow = open ? 'hidden' : ''; };
      more.addEventListener('click', () => show(sheet.hidden !== false));
      scrim.addEventListener('click', () => show(false));
      sheet.querySelector('[data-ash-close]')?.addEventListener('click', () => show(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) show(false); });
    }
    document.querySelectorAll('[data-ash-out]').forEach((b) => b.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.href = '/';
    }));
  });
</script>
