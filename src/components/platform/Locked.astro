---
/** Shown instead of a lab whose module staff have locked. Students still see the module and its list of labs. */
interface Props { title: string; code?: string; color?: string; description?: string; back: string }
const { title, code, color = '#7cb1ff', description, back } = Astro.props;
---
<section class="lk" style={`--c:${color}`}>
  <div class="lk-sky" aria-hidden="true"></div>
  <div class="container lk-in glass">
    <span class="lk-ic" aria-hidden="true">🔒</span>
    <p class="lk-k mono">{code || 'Module'} · locked</p>
    <h1>{title}</h1>
    {description && <p class="lk-d">{description}</p>}
    <p class="lk-why">Your teaching team has <b>locked this module's labs</b> for now. You can still see the module and its list of labs. Check back later.</p>
    <div class="lk-act">
      <a class="btn btn-primary" href={back}>Back to the module</a>
      <a class="btn btn-ghost" href="/modules">All modules</a>
    </div>
  </div>
</section>

<style>
  .lk { position: relative; min-height: 100dvh; display: grid; place-items: center; padding: calc(var(--nav-h) + 40px) 0 80px; background: var(--hero-bg); color: var(--hero-text); isolation: isolate; overflow: hidden; overflow: clip; }
  .lk-sky { position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 50% 0%, color-mix(in oklab, var(--c) 40%, transparent), transparent 55%); }
  .lk-in { max-width: 680px; padding: clamp(28px, 5vw, 48px); display: grid; gap: 14px; justify-items: start; }
  .lk-ic { font-size: 34px; filter: drop-shadow(0 0 18px var(--c)); }
  .lk-k { font-size: 12px; color: var(--hero-accent); }
  h1 { font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4rem); letter-spacing: -.05em; line-height: .95; }
  .lk-d, .lk-why { color: var(--hero-lead); }
  .lk-why b { color: var(--hero-text); }
  .lk-act { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
</style>
