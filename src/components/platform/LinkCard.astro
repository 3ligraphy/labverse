---
/**
 * A tool or resource to open in a new tab (WordPress, ChatGPT, a template gallery…). The whole card is the link.
 *   <LinkCard title="WordPress.com" url="https://wordpress.com/start" description="Create your free site" cta="Open WordPress" />
 */
import { hostOf } from '@/lib/platform/web';

interface Props { title: string; url: string; description: string; cta: string }
const { title, url, description, cta } = Astro.props;
const host = hostOf(url);
const initial = (host.replace(/^(app|my|go)\./, '')[0] ?? '↗').toUpperCase();
---
<a class="lc" href={url} target="_blank" rel="noopener noreferrer" data-reveal>
  <span class="lc-tile mono" aria-hidden="true">{initial}</span>
  <span class="lc-body">
    <span class="lc-host mono">{host}</span>
    <span class="lc-title">{title}</span>
    {description && <span class="lc-desc">{description}</span>}
  </span>
  <span class="lc-cta">
    {cta}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
  </span>
  <span class="sr-only">(opens in a new tab)</span>
</a>

<style>
  .lc {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px 16px;
    padding: 16px; border-radius: var(--r-lg); border: 1px solid var(--line); text-decoration: none !important; color: var(--text) !important;
    background: linear-gradient(135deg, var(--accent-soft), transparent 55%), var(--surface);
    transition: opacity 800ms var(--ease-out), border-color var(--t-med), transform var(--t-med) var(--ease-out), box-shadow var(--t-med);
  }
  .lc:hover { border-color: color-mix(in oklab, var(--accent-text) 55%, var(--line)); transform: translateY(-2px); box-shadow: 0 16px 36px -18px var(--accent-glow); }
  .lc-tile {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; font-size: 20px; font-weight: 700;
    background: var(--bg); border: 1px solid var(--line-2); color: var(--accent-text);
  }
  .lc-body { display: grid; gap: 2px; min-width: 0; }
  .lc-host { font-size: 12px; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lc-title { font-family: var(--font-display); font-size: 1.12rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; }
  .lc-desc { font-size: 14.5px; color: var(--text-2); line-height: 1.5; }
  .lc-cta {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; white-space: nowrap;
    background: var(--accent); color: var(--accent-ink); font-size: 14px; font-weight: 600;
  }
  .lc-cta svg { width: 16px; height: 16px; transition: transform var(--t-med) var(--ease-out); }
  .lc:hover .lc-cta svg { transform: translate(2px, -2px); }
  @media (max-width: 560px) {
    .lc { grid-template-columns: auto minmax(0, 1fr); }
    .lc-cta { grid-column: 1 / -1; justify-content: center; height: 46px; }
  }
  @media (prefers-reduced-motion: reduce) { .lc, .lc-cta svg { transition: none; } .lc:hover { transform: none; } .lc:hover .lc-cta svg { transform: none; } }
</style>
