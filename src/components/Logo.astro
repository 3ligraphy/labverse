---
/** Brand mark: a bold B (BUE) with a nova star rising beside it — BUENOVA. Same drawing as public/favicon.svg. */
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="logo" style={`--sz:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 32 32" width={size} height={size}>
    <rect x="1" y="1" width="30" height="30" rx="9" class="bg" />
    <g transform="translate(-0.9 0.4)">
      <path class="ink" fill-rule="evenodd" d="M8.5 6.5h8.2a5.3 5.3 0 0 1 3.9 8.9a5.6 5.6 0 0 1-3.2 10.1H8.5Zm4 3.6v5.4h3.2a2.7 2.7 0 0 0 0-5.4Zm0 8.8v3.1h4.7a1.55 1.55 0 0 0 0-3.1Z" />
      <path class="ink nova" d="M24.6 5.2c.35 2.3 1.15 3.1 3.45 3.45c-2.3.35-3.1 1.15-3.45 3.45c-.35-2.3-1.15-3.1-3.45-3.45c2.3-.35 3.1-1.15 3.45-3.45Z" />
    </g>
  </svg>
</span>
<style>
  .logo { display: inline-grid; width: var(--sz); height: var(--sz); }
  .bg { fill: var(--accent); }
  .ink { fill: var(--accent-ink); }
  .nova { transform-box: fill-box; transform-origin: center; animation: nova 3.2s ease-in-out infinite; }
  @keyframes nova { 0%, 70%, 100% { transform: scale(1) rotate(0); } 82% { transform: scale(1.25) rotate(45deg); } }
  @media (prefers-reduced-motion: reduce) { .nova { animation: none; } }
</style>
