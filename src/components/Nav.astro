---
import Icon from './Icon.astro';
import InstitutionBrand from './InstitutionBrand.astro';
import Logo from './Logo.astro';
import { nav as courseSections, course, platform } from '@/site.config';
import { moduleSections, moduleSectionHref } from '@/lib/platform/module-sections';

/**
 * The site navbar, the same on every page: the brand (home), All modules, search, light/dark, and Sign in — or
 * Profile once signed in, plus Admin for staff (shown by the script below). Inside a module (the built-in course or
 * a builder module) a second row lists that module's sections; the first row never changes.
 * Admin pages have no site navbar (Base.astro): they have their own menu and a Back button.
 */
interface Props { module?: { slug: string; title: string; color?: string } }
const { module } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const COURSE = /^\/mobile-development(\/|$)/;
const preview = Astro.url.searchParams.has('preview');
// a builder module's sections open at its workspace, below the module's header
const sectionLink = (slug: string, label: string) => moduleSectionHref(slug, label, preview) + (label.toLowerCase() === 'overview' ? '' : '#workspace');
const context = module
  ? { title: module.title, color: module.color ?? '#7cb1ff', home: moduleSectionHref(module.slug, 'overview', preview), items: moduleSections(module.slug).map((label) => ({ label, href: sectionLink(module.slug, label) })) }
  : COURSE.test(path) ? { title: course.name, color: '#c8ff4d', home: '/mobile-development', items: courseSections } : null;
// the sign-in page is the sign-in: no second "Sign in" button above it
const onLogin = path === '/login';
const isActive = (href: string) => {
  if (module) {
    const target = new URL(href, Astro.url);
    const section = target.searchParams.get('tab') ?? 'overview';
    // a lab page is under Labs; a hand-in page (/<module>/submit/…) under none of them
    if (path.startsWith(`/${module.slug}/submit/`)) return false;
    return path.startsWith(`/${module.slug}/`) ? section === 'labs' : path === target.pathname && section === (Astro.url.searchParams.get('tab') ?? 'overview');
  }
  // the course home is the parent of every course page, so it is only active on itself
  return path === href.replace(/#.*$/, '') || (href !== '/' && href !== '/mobile-development' && !href.includes('#') && path.startsWith(href + '/'));
};
---
<header class="nav" data-nav>
  <div class="nav-inner container">
    <a href="/" class="brand" aria-label={`${platform.name}: home`}>
      <Logo />
      <span class="brand-text">
        <span class="brand-name">{platform.name}</span>
        <span class="brand-sub mono">{platform.tagline}</span>
      </span>
    </a>

    <div class="nav-institution"><InstitutionBrand compact /></div>

    <nav aria-label="Primary" class="nav-links">
      <ul>
        <li><a href="/modules" aria-current={path === '/modules' ? 'page' : undefined}>All modules</a></li>
        <li data-nav-admin hidden><a href="/admin">Admin</a></li>
      </ul>
    </nav>

    <div class="nav-actions">
      <button class="search-trigger" data-search-open aria-label="Search (Ctrl K)">
        <Icon name="search" size={16} />
        <span class="hide-sm">Search</span>
        <span class="keys hide-sm kbd-hint"><kbd class="kbd" data-mod-key>Ctrl</kbd><kbd class="kbd">K</kbd></span>
      </button>
      {!onLogin && <a class="nav-account" href="/login" data-nav-account data-pending>Sign in</a>}
      <button class="icon-btn theme-toggle" data-theme-toggle aria-label="Switch between light and dark">
        <Icon name="sun" class="i-sun" />
        <Icon name="moon" class="i-moon" />
      </button>
    </div>
  </div>

  {context && (
    <div class="modbar" style={`--mc:${context.color}`}>
      <div class="modbar-inner container">
        <a class="modbar-title" href={context.home}><i aria-hidden="true"></i><span>{context.title}</span></a>
        <nav class="modbar-links" aria-label={`${context.title}: sections`}>
          {context.items.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </div>
  )}
</header>

<nav class="tabbar" aria-label="Main">
  <a class="tab" href="/" aria-current={path === '/' ? 'page' : undefined}><Icon name="sparkle" size={20} /><span>Home</span></a>
  <a class="tab" href="/modules" aria-current={path === '/modules' ? 'page' : undefined}><Icon name="grid" size={20} /><span>All modules</span></a>
  <button type="button" class="tab" data-search-open><Icon name="search" size={20} /><span>Search</span></button>
  <a class="tab" href="/login" data-tab-account aria-current={path === '/login' || path === '/account' ? 'page' : undefined}><Icon name="key" size={20} /><span>Sign in</span></a>
  <a class="tab" href="/admin" data-nav-admin hidden><Icon name="wrench" size={20} /><span>Admin</span></a>
</nav>

<style>
  .nav-account { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
    border: 1px solid var(--line-2); color: var(--text); white-space: nowrap; transition: border-color var(--t-fast), background var(--t-fast); }
  .nav-account:hover { border-color: var(--accent-text); }
  /* hidden until the page knows who is signed in, so it never flashes "Sign in" (shown anyway after 1.5s) */
  .nav-account[data-pending] { visibility: hidden; animation: nav-account-show 0s 1.5s forwards; }
  @keyframes nav-account-show { to { visibility: visible; } }
  .nav-account.in { background: var(--accent-soft); border-color: color-mix(in oklab, var(--accent-text) 40%, var(--line-2)); }
  @media (max-width: 719px) { .nav-account { display: none; } }

  /* phones: the same four places as a bottom tab bar (plus Admin for staff); the header keeps brand, search and theme */
  .tabbar { display: none; }
  @media (max-width: 719px) {
    .nav-inner { gap: 8px; }
    .tabbar { position: fixed; z-index: 95; left: 0; right: 0; bottom: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
      padding: 6px 6px calc(env(safe-area-inset-bottom) + 6px); background: color-mix(in oklab, var(--surface) 92%, transparent); border-top: 1px solid var(--line);
      backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); }
    .tab { position: relative; display: grid; justify-items: center; gap: 3px; padding: 6px 0 4px; border: 0; background: none; color: var(--text-3);
      font: 600 12px var(--font-body); letter-spacing: .01em; -webkit-tap-highlight-color: transparent; }
    .tab[hidden] { display: none; }
    .tab:active { transform: scale(.94); }
    .tab[aria-current='page'] { color: var(--text); }
    .tab[aria-current='page']::before { content: ''; position: absolute; top: -6px; left: 50%; width: 22px; height: 3px; translate: -50% 0; border-radius: 0 0 3px 3px; background: var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
    .tab[aria-current='page'] :global(svg) { color: var(--accent-text); }
    :global(body:not(:has(.ash, .cv))) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  }
  .nav {
    --bar-h: 64px;
    position: fixed; inset: 0 0 auto; z-index: 100;
    transition: background var(--t-med), border-color var(--t-med);
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled], .nav:has(.modbar) {
    background: var(--glass); border-bottom-color: var(--line);
    backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px);
  }
  .nav[data-scrolled] { --bar-h: 56px; }
  .nav-inner { height: var(--bar-h); display: flex; align-items: center; gap: 24px; transition: height var(--t-med) var(--ease-out); }
  .brand { display: inline-flex; align-items: center; gap: 12px; flex: none; }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-name { font-family: var(--font-display); font-weight: 650; letter-spacing: -0.02em; font-size: 16px; }
  .brand-sub { font-size: 12px; color: var(--text-3); letter-spacing: 0.02em; }
  .nav[data-scrolled] .brand-sub { display: none; }
  .nav-institution { display: none; }
  @media (min-width: 1500px) { .nav-institution { display: block; } }

  .nav-links { margin-inline: auto; display: none; }
  .nav-links ul { display: flex; gap: 2px; list-style: none; padding: 4px; border-radius: var(--r-full); }
  .nav-links li[hidden] { display: none; }
  .nav-links a {
    position: relative; display: block; padding: 7px 13px; border-radius: var(--r-full); white-space: nowrap;
    font-size: 13.5px; font-weight: 500; color: var(--text-2); transition: color var(--t-fast), background var(--t-fast);
  }
  .nav-links a:hover { color: var(--text); background: var(--surface-2); }
  .nav-links a[aria-current='page'] { color: var(--text); background: var(--surface-2); box-shadow: 0 0 0 1px var(--line-2) inset; }
  .nav-links a[aria-current='page']::after {
    content: ''; position: absolute; left: 50%; bottom: -6px; width: 4px; height: 4px; border-radius: 50%;
    background: var(--accent); translate: -50% 0; box-shadow: 0 0 10px var(--accent-glow);
  }
  @media (min-width: 720px) { .nav-links { display: block; } }

  .nav-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  @media (min-width: 720px) { .nav-actions { margin-left: 0; } }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 8px 0 12px;
    border-radius: var(--r-full); border: 1px solid var(--line-2); color: var(--text-3); font-size: 13px;
    background: var(--surface); transition: border-color var(--t-fast), color var(--t-fast);
  }
  .search-trigger:hover { color: var(--text); border-color: var(--text-3); }
  .search-trigger .keys { display: inline-flex; gap: 3px; }
  @media (max-width: 1100px) { .search-trigger .keys { display: none; } }
  @media (max-width: 719px) { .search-trigger { width: 40px; padding: 0; justify-content: center; border-color: transparent; background: none; } }

  .theme-toggle :global(svg) { transition: transform var(--t-slow) var(--ease-out); }
  .theme-toggle:active :global(svg) { transform: rotate(90deg) scale(0.8); }

  /* inside a module: its sections, in the module's colour, on a second row */
  .modbar { border-top: 1px solid var(--line); }
  .modbar-inner { height: 44px; display: flex; align-items: center; gap: 14px; }
  .modbar-title { display: inline-flex; align-items: center; gap: 8px; flex: none; max-width: 38%; font-size: 13.5px; font-weight: 650; color: var(--text); }
  .modbar-title span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .modbar-title i { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--mc); box-shadow: 0 0 10px var(--mc); }
  .modbar-links { display: flex; gap: 2px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .modbar-links::-webkit-scrollbar { display: none; }
  .modbar-links a { flex: none; padding: 6px 11px; border-radius: var(--r-full); font-size: 13px; color: var(--text-2); white-space: nowrap; transition: color var(--t-fast), background var(--t-fast); }
  .modbar-links a:hover { color: var(--text); background: var(--surface-2); }
  .modbar-links a[aria-current='page'] { color: var(--text); background: color-mix(in oklab, var(--mc) 16%, var(--surface-2)); box-shadow: inset 0 -2px var(--mc); }
  @media (max-width: 719px) { .modbar-title { max-width: 42%; font-size: 13px; } }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  import { getMe } from '@/scripts/me';
  /** the last page of the site itself, for the admin pages' Back button */
  const BACK = 'buenova:back';
  /** Sign in → Profile once signed in; staff (and the admin password) also get Admin. */
  async function account() {
    const a = document.querySelector<HTMLAnchorElement>('[data-nav-account]');
    const tab = document.querySelector<HTMLAnchorElement>('[data-tab-account]');
    // signed out: come back to this page after signing in (the login page only accepts same-site paths)
    const here = location.pathname + location.search;
    const signIn = location.pathname.startsWith('/login') ? '/login' : `/login?next=${encodeURIComponent(here)}`;
    if (a) a.href = signIn;
    if (tab) tab.href = signIn;
    const footer = document.querySelectorAll<HTMLAnchorElement>('[data-account-link]');
    footer.forEach((l) => (l.href = signIn));
    const me = await getMe<{ user: { name: string; role: string } | null; staff?: boolean }>();
    a?.removeAttribute('data-pending');
    if (me?.staff) document.querySelectorAll<HTMLElement>('[data-nav-admin]').forEach((el) => (el.hidden = false));
    if (!me?.user) return;
    footer.forEach((l) => { l.textContent = 'Profile'; l.href = '/account'; });
    if (tab) { tab.href = '/account'; tab.querySelector('span')!.textContent = 'Profile'; }
    if (!a) return;
    a.textContent = 'Profile';
    a.title = `Signed in as ${me.user.name}`;
    a.href = '/account';
    a.classList.add('in');
  }
  onPageLoad(() => {
    try { sessionStorage.setItem(BACK, location.pathname + location.search + location.hash); } catch { /* storage off: Back goes home */ }
    void account();
  });
</script>
