---
import Icon from './Icon.astro';
import InstitutionBrand from './InstitutionBrand.astro';
import Logo from './Logo.astro';
import { nav, secondaryNav, course, platform } from '@/site.config';

/**
 * Students choose a module first: the platform pages (module chooser, sign-in, admin) show no section links.
 * Inside the built-in course the nav lists its sections; inside a builder module, that module's.
 */
interface Props { module?: { slug: string; title: string; color?: string } }
const { module } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const COURSE = /^\/(course|labs|coursework|project|commands|tools|setup|resources|troubleshooting|extra|submit|attendance)(\/|$)/;
const context = module
  ? { title: module.title, color: module.color ?? '#7cb1ff', items: [{ label: 'Overview', href: `/m/${module.slug}` }, { label: 'Labs', href: `/m/${module.slug}#labs` }] }
  : COURSE.test(path) ? { title: course.name, color: '#c8ff4d', items: nav } : null;
const items = context?.items ?? [];
const isActive = (href: string) => path === href.replace(/#.*$/, '') || (href !== `/m/${module?.slug}` && !href.includes('#') && path.startsWith(href + '/'));

/** Phones: the main sections as a bottom tab bar, like an app. "More" opens the full menu. */
type Tab = { label: string; icon: 'grid' | 'book' | 'flask' | 'search' | 'file' | 'rocket' | 'key'; href?: string; kind?: 'search' | 'account'; on?: boolean };
const tabs: Tab[] = module
  ? [{ label: 'Modules', icon: 'grid', href: '/' }, { label: 'Overview', icon: 'book', href: `/m/${module.slug}`, on: path === `/m/${module.slug}` },
     { label: 'Labs', icon: 'flask', href: `/m/${module.slug}#labs`, on: path.startsWith(`/m/${module.slug}/`) }, { label: 'Search', icon: 'search', kind: 'search' }]
  : COURSE.test(path)
    ? [{ label: 'Course', icon: 'book', href: '/course' }, { label: 'Labs', icon: 'flask', href: '/labs' },
       { label: 'Coursework', icon: 'file', href: '/coursework' }, { label: 'Project', icon: 'rocket', href: '/project' }]
    : [{ label: 'Modules', icon: 'grid', href: '/', on: path === '/' || path === '/modules' }, { label: 'Search', icon: 'search', kind: 'search' },
       { label: 'Account', icon: 'key', href: '/login', kind: 'account', on: path === '/login' || path === '/account' }];
for (const t of tabs) t.on ??= Boolean(t.href && t.href !== '/' && isActive(t.href));
---
<header class="nav" data-nav>
  <div class="nav-inner container">
    <a href="/" class="brand" aria-label={`${platform.name} — choose a module`}>
      <Logo />
      <span class="brand-text">
        <span class="brand-name">{platform.name}</span>
        <span class="brand-sub mono">{context ? context.title : platform.tagline}</span>
      </span>
    </a>

    <div class="nav-institution"><InstitutionBrand compact /></div>

    <nav aria-label="Primary" class="nav-links">
      <ul>
        {context && <li><a href="/" class="nav-modules" style={`--mc:${context.color}`}>← Modules</a></li>}
        {items.map((item) => (
          <li>
            <a href={item.href} data-nav-link aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <button class="search-trigger" data-search-open aria-label="Search the course (Ctrl K)">
        <Icon name="search" size={16} />
        <span class="hide-sm">Search</span>
        <span class="keys hide-sm"><kbd class="kbd" data-mod-key>Ctrl</kbd><kbd class="kbd">K</kbd></span>
      </button>
      <a class="nav-account" href="/login" data-nav-account>Sign in</a>
      <button class="icon-btn theme-toggle" data-theme-toggle aria-label="Toggle color theme">
        <Icon name="sun" class="i-sun" />
        <Icon name="moon" class="i-moon" />
      </button>
      <button class="icon-btn menu-btn" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

</header>

<!-- Outside <header>: the scrolled header uses backdrop-filter, which would make it the containing block of this
     position:fixed menu and squeeze the menu into the header bar. -->
<div id="mobile-menu" class="mobile-menu" data-menu role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mm-top container">
    <a href="/" class="brand"><Logo /><span class="brand-name">{platform.name}</span></a>
    <button class="icon-btn" data-menu-close aria-label="Close menu"><Icon name="close" /></button>
  </div>
  <nav aria-label="Mobile" class="container mm-body">
    <ol class="mm-list">
      <li style="--i:0"><a href="/"><span class="mono ix">00</span><span>All modules</span></a></li>
      {items.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="mono ix">{String(i + 1).padStart(2, '0')}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="mm-secondary" hidden={!context || Boolean(module)}>
      {secondaryNav.map((item) => <a href={item.href} class="chip">{item.label}</a>)}
    </div>
  </nav>
</div>

<nav class="tabbar" aria-label="Sections">
  {tabs.map((t) => t.kind === 'search'
    ? <button type="button" class="tab" data-search-open><Icon name={t.icon} size={20} /><span>{t.label}</span></button>
    : <a class="tab" href={t.href} aria-current={t.on ? 'page' : undefined} data-tab-account={t.kind === 'account' ? '' : undefined}><Icon name={t.icon} size={20} /><span>{t.label}</span></a>)}
  <button type="button" class="tab" data-menu-open aria-controls="mobile-menu"><Icon name="menu" size={20} /><span>More</span></button>
</nav>

<style>
  .nav-modules { color: var(--mc) !important; font-weight: 600; }
  :global(:root[data-theme='light']) .nav-modules { color: color-mix(in oklab, var(--mc) 50%, #000) !important; }
  .nav-account { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
    border: 1px solid var(--line-2); color: var(--text); white-space: nowrap; transition: border-color var(--t-fast), background var(--t-fast); }
  .nav-account:hover { border-color: var(--accent-text); }
  .nav-account.in { background: var(--accent-soft); border-color: color-mix(in oklab, var(--accent-text) 40%, var(--line-2)); }
  @media (max-width: 640px) { .nav-account { display: none; } }

  /* phones: an app-style bottom tab bar; the header keeps the brand, search and theme */
  .tabbar { display: none; }
  @media (max-width: 719px) {
    .nav-inner { gap: 8px; }
    .menu-btn { display: none !important; }
    .tabbar { position: fixed; z-index: 95; left: 0; right: 0; bottom: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
      padding: 6px 6px calc(env(safe-area-inset-bottom) + 6px); background: color-mix(in oklab, var(--surface) 92%, transparent); border-top: 1px solid var(--line);
      backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); }
    .tab { position: relative; display: grid; justify-items: center; gap: 3px; padding: 6px 0 4px; border: 0; background: none; color: var(--text-3);
      font: 600 10.5px var(--font-body); letter-spacing: .01em; -webkit-tap-highlight-color: transparent; }
    .tab:active { transform: scale(.94); }
    .tab[aria-current='page'] { color: var(--text); }
    .tab[aria-current='page']::before { content: ''; position: absolute; top: -6px; left: 50%; width: 22px; height: 3px; translate: -50% 0; border-radius: 0 0 3px 3px; background: var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
    .tab[aria-current='page'] :global(svg) { color: var(--accent-text); }
    :global(body:not(:has(.ash, .cv))) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    :global(body:has(.ash, .cv)) .tabbar { display: none; } /* admin pages and the builder have their own */
  }
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 100; height: var(--nav-h);
    transition: background var(--t-med), border-color var(--t-med), height var(--t-med) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled] {
    --nav-h: 56px;
    background: var(--glass); border-bottom-color: var(--line);
    backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; flex: none; }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-name { font-family: var(--font-display); font-weight: 650; letter-spacing: -0.02em; font-size: 16px; }
  .brand-sub { font-size: 10.5px; color: var(--text-3); letter-spacing: 0.02em; }
  .nav[data-scrolled] .brand-sub { display: none; }
  .nav-institution { display: none; }
  @media (min-width: 1500px) { .nav-institution { display: block; } }

  .nav-links { margin-inline: auto; display: none; }
  .nav-links ul { display: flex; gap: 2px; list-style: none; padding: 4px; border-radius: var(--r-full); }
  .nav-links a {
    position: relative; display: block; padding: 7px 13px; border-radius: var(--r-full);
    font-size: 13.5px; font-weight: 500; color: var(--text-2); transition: color var(--t-fast), background var(--t-fast);
  }
  .nav-links a { white-space: nowrap; }
  .nav-links a:hover { color: var(--text); background: var(--surface-2); }
  /* laptops: the course nav has 9 links; keep them on one line beside search and sign-in */
  @media (min-width: 1180px) and (max-width: 1360px) {
    .nav-inner { gap: 14px; }
    .nav-links a { padding: 7px 9px; font-size: 13px; }
    .search-trigger .keys { display: none; }
  }
  .nav-links a[aria-current='page'] { color: var(--text); background: var(--surface-2); box-shadow: 0 0 0 1px var(--line-2) inset; }
  .nav-links a[aria-current='page']::after {
    content: ''; position: absolute; left: 50%; bottom: -6px; width: 4px; height: 4px; border-radius: 50%;
    background: var(--accent); translate: -50% 0; box-shadow: 0 0 10px var(--accent-glow);
  }
  @media (min-width: 1180px) { .nav-links { display: block; } .menu-btn { display: none !important; } }

  .nav-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  @media (min-width: 1180px) { .nav-actions { margin-left: 0; } }
  .search-trigger {
    display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 8px 0 12px;
    border-radius: var(--r-full); border: 1px solid var(--line-2); color: var(--text-3); font-size: 13px;
    background: var(--surface); transition: border-color var(--t-fast), color var(--t-fast);
  }
  .search-trigger:hover { color: var(--text); border-color: var(--text-3); }
  .search-trigger .keys { display: inline-flex; gap: 3px; }
  @media (max-width: 719px) { .search-trigger { width: 40px; padding: 0; justify-content: center; border-color: transparent; background: none; } }

  .theme-toggle :global(.i-sun) { display: none; }
  :global(:root[data-theme='light']) .theme-toggle :global(.i-sun) { display: block; }
  :global(:root[data-theme='light']) .theme-toggle :global(.i-moon) { display: none; }
  .theme-toggle :global(svg) { transition: transform var(--t-slow) var(--ease-out); }
  .theme-toggle:active :global(svg) { transform: rotate(90deg) scale(0.8); }

  /* mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 200; background: var(--bg);
    display: flex; flex-direction: column; overflow-y: auto;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu.open { animation: mm-in 380ms var(--ease-out); }
  @keyframes mm-in { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0); } }
  .mm-top { display: flex; align-items: center; justify-content: space-between; height: 64px; flex: none; }
  .mm-body { padding-block: 24px 40px; display: flex; flex-direction: column; gap: 32px; flex: 1; }
  .mm-list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .mm-list li { border-bottom: 1px solid var(--line); }
  .mobile-menu.open .mm-list li { animation: mm-item 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 35ms + 80ms); }
  @keyframes mm-item { from { opacity: 0; transform: translateY(12px); } }
  .mm-list a { display: flex; align-items: baseline; gap: 16px; padding: 16px 2px; font-family: var(--font-display); font-size: clamp(28px, 8vw, 40px); font-weight: 600; letter-spacing: -0.03em; }
  .mm-list a[aria-current='page'] { color: var(--accent-text); }
  .mm-list .ix { font-size: 12px; color: var(--text-3); font-family: var(--font-mono); letter-spacing: 0; }
  .mm-secondary { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  import { getMe } from '@/scripts/me';
  /** Sign in → "Name · role" once signed in (doctors and TAs go to /admin, students to their modules). */
  async function account() {
    const a = document.querySelector<HTMLAnchorElement>('[data-nav-account]');
    if (!a) return;
    const tab = document.querySelector<HTMLAnchorElement>('[data-tab-account]');
    // signed out: come back to this page after signing in (the login page only accepts same-site paths)
    const here = location.pathname + location.search;
    const signIn = location.pathname.startsWith('/login') ? '/login' : `/login?next=${encodeURIComponent(here)}`;
    a.href = signIn;
    if (tab) tab.href = signIn;
    const me = await getMe<{ user: { name: string; role: string } | null }>();
    if (!me?.user) return;
    const first = me.user.name.split(' ')[0];
    a.textContent = `${first} · ${({ super_admin: 'super admin', doctor: 'Dr.', ta: 'TA', student: 'student' } as Record<string, string>)[me.user.role] ?? me.user.role}`;
    a.href = '/account';
    a.classList.add('in');
    if (tab) { tab.href = me.user.role === 'student' ? '/account' : '/admin'; tab.querySelector('span')!.textContent = first; }
  }
  onPageLoad( () => void account());
</script>
