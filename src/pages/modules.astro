---
/**
 * All modules, by faculty and then by year: a tab per faculty, and under it every year of the catalogue
 * (Admin → Catalogue), each with its modules — or "No modules yet". A module for every year is listed under each
 * year; a module for every faculty under each faculty. Every module is open to everyone; a lock (set by staff on
 * the module page) is shown on its card. The faculty comes from ?faculty=, else the student's own, else the first.
 */
import Base from '@/layouts/Base.astro';
import { hubData } from '@/lib/accounts/hub';
import { ANY_FACULTY } from '@/lib/accounts/core';
import { yearId } from '@/lib/platform/trail';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=120');
const { cards, settings } = await hubData();
const asked = Astro.url.searchParams.get('faculty') ?? '';
const selected = settings.faculties.some((f) => f.slug === asked) ? asked : '';
const panels = settings.faculties.map((f) => {
  const mine = cards.filter((c) => c.faculty === f.slug || c.faculty === ANY_FACULTY);
  return {
    faculty: f, count: mine.length,
    years: settings.years.map((year) => ({ year, cards: mine.filter((c) => !c.years.length || c.years.some((y) => y.toLowerCase() === year.toLowerCase())) })),
  };
});
const first = selected || settings.faculties[0]?.slug || '';
---
<Base title="All modules" description="Every module, by faculty and year. Open any lab, any time.">
  <section class="md" data-md data-asked={selected}>
    <div class="md-sky" aria-hidden="true"></div>
    <div class="container">
      <p class="md-k mono">All modules · {settings.activeSemester} is active · {cards.length} module{cards.length === 1 ? '' : 's'}</p>
      <h1 class="md-t">All <span>modules</span></h1>
      <p class="md-l">Choose your faculty, then your year. Every lab is open to everyone, any time, unless its teaching team locks it.</p>

      <nav class="md-tabs" aria-label="Faculties">
        {panels.map((p) => (
          <a href={`/modules?faculty=${encodeURIComponent(p.faculty.slug)}`} data-tab={p.faculty.slug} aria-current={p.faculty.slug === first ? 'page' : undefined}>
            {p.faculty.name}<small class="mono">{p.count}</small>
          </a>
        ))}
      </nav>
      <input class="md-q" type="search" placeholder="Search modules by name, code or description" data-md-q aria-label="Search modules" />

      {panels.map((p) => (
        <div class="md-panel" data-panel={p.faculty.slug} hidden={p.faculty.slug !== first}>
          {p.years.map((y) => (
            <section class="md-group" id={yearId(y.year, p.faculty.slug)} data-group>
              <h2 class="md-gh"><span>{y.year}</span><small class="mono" data-group-count>{y.cards.length} module{y.cards.length === 1 ? '' : 's'}</small></h2>
              {y.cards.length ? (
                <div class="md-grid">
                  {y.cards.map((m, i) => (
                    <article class="mcard" style={`--c:${m.color}; --i:${i}`} data-card data-text={`${m.title} ${m.code} ${m.description} ${m.term}`.toLowerCase()}>
                      <span class="mcard-top"><span>{m.code || 'Module'}</span><span class="mcard-tag">{m.category}</span></span>
                      <h3><a class="module-card-link" href={m.href}>{m.title}</a></h3>
                      <span class="md-chips mono">
                        <span class:list={['md-chip', { on: m.semester === settings.activeSemester || m.semester === 'Both' }]}>{m.semester === 'Both' ? 'Both semesters' : m.semester}</span>
                        {!m.years.length && <span class="md-chip">Every year</span>}
                        {m.faculty === ANY_FACULTY && <span class="md-chip">Every faculty</span>}
                        {m.specializations.map((s) => <span class="md-chip spec">{s}</span>)}
                      </span>
                      {m.description && <p>{m.description}</p>}
                      {m.locked && <span class="md-lock mono">🔒 Labs locked by the teaching team</span>}
                      <span class="mcard-foot"><span>{m.labs} lab{m.labs === 1 ? '' : 's'}{m.term && ` · ${m.term}`}</span><span class="mcard-go" aria-hidden="true">→</span></span>
                    </article>
                  ))}
                </div>
              ) : <p class="md-empty">No modules yet.</p>}
              <p class="md-empty" data-none hidden>No module here matches your search.</p>
            </section>
          ))}
        </div>
      ))}

      <section class="md-group md-open-session">
        <h2 class="md-gh"><span>Open study sessions</span><small class="mono">NO SIGN-IN REQUIRED</small></h2>
        <div class="md-grid">
          <article class="mcard" style="--c:#63e6ff; --i:0">
            <span class="mcard-top"><span>Wireless Networks</span><span class="mcard-tag">open module</span></span>
            <h3><a class="module-card-link" href="/wireless">Wireless Networks</a></h3>
            <span class="md-chips mono"><span class="md-chip on">Lectures</span><span class="md-chip on">Labs</span><span class="md-chip">Interactive</span></span>
            <p>Interactive lectures linked slide by slide to their PDFs (Week 1: Wireless communication), and guided labs (Week 6: Sheet 3, antennas &amp; propagation).</p>
            <span class="mcard-foot"><span>1 lecture · 1 lab</span><span class="mcard-go" aria-hidden="true">→</span></span>
          </article>
        </div>
      </section>
    </div>
  </section>
</Base>

<style is:global>
  .md { --g1: #c8ff4d; --g2: #7cb1ff; position: relative; min-height: 100dvh; padding: calc(var(--nav-h) + 48px) 0 100px; background: var(--hero-bg); color: var(--hero-text); isolation: isolate; overflow: hidden; }
  :root[data-theme='light'] .md { --g1: #9fd400; --g2: #3d7be0; }
  .md-sky { position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 90% -10%, color-mix(in oklab, var(--g2) 35%, transparent), transparent 45%), radial-gradient(circle at 0% 30%, color-mix(in oklab, var(--g1) 25%, transparent), transparent 40%); }
  .md-k { font-size: 12px; color: var(--hero-accent); }
  .md-t { margin-top: 14px; font-size: clamp(2.6rem, 1.4rem + 5vw, 6rem); letter-spacing: -.04em; line-height: .92; }
  .md-t span { color: var(--hero-accent); }
  .md-l { margin-top: 18px; max-width: 66ch; color: var(--hero-lead); font-size: var(--fs-md); }
  .md-tabs { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 8px; }
  .md-tabs a { display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-lead); font-weight: 600; background: color-mix(in oklab, var(--hero-bg) 55%, transparent); backdrop-filter: blur(10px); }
  .md-tabs a small { font-size: 12px; padding: 2px 8px; border-radius: 99px; background: color-mix(in oklab, var(--hero-text) 10%, transparent); }
  .md-tabs a[aria-current='page'] { color: var(--hero-text); border-color: var(--hero-accent); background: color-mix(in oklab, var(--hero-accent) 14%, transparent); }
  .md-q { margin-top: 14px; width: min(100%, 520px); height: 50px; padding: 0 20px; border-radius: 999px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-bg) 60%, transparent); color: var(--hero-text); font: 16px var(--font-body); backdrop-filter: blur(12px); }
  .md-q:focus { outline: none; border-color: var(--hero-accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--hero-accent) 20%, transparent); }
  .md-group { margin-top: 40px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .md-gh { display: flex; align-items: baseline; gap: 14px; font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.6rem); letter-spacing: -.04em; padding-bottom: 12px; border-bottom: 1px solid var(--hero-line); }
  .md-gh small { font-size: 12px; letter-spacing: .08em; color: var(--hero-dim); }
  .md-empty { margin-top: 16px; padding: 18px 20px; border-radius: 16px; border: 1px dashed var(--hero-line); color: var(--hero-lead); }
  .md-grid { margin-top: 18px; display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .md-chips { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; letter-spacing: .05em; text-transform: uppercase; }
  .md-chip { padding: 3px 9px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-lead); }
  .md-chip.on { border-color: var(--hero-accent); color: var(--hero-accent); }
  .md-chip.spec { border-color: color-mix(in oklab, var(--c) 55%, var(--hero-line)); color: var(--hero-text); }
  .md-lock { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--hero-warn); }
  .md .mcard { position: relative; display: grid; gap: 12px; align-content: start; min-height: 220px; padding: 24px; border-radius: 24px; overflow: hidden; color: var(--hero-text); isolation: isolate;
    border: 1px solid color-mix(in oklab, var(--c) 35%, var(--hero-line)); background: color-mix(in oklab, var(--hero-bg) 50%, transparent); backdrop-filter: blur(14px); transition: transform 300ms var(--ease-out), box-shadow 300ms; }
  .md .mcard > * { min-width: 0; }
  .md .mcard::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--c) 45%, transparent), transparent 65%); z-index: -1; opacity: .5; }
  .md .mcard:hover { transform: translateY(-5px); box-shadow: 0 26px 50px -28px color-mix(in oklab, var(--c) 70%, transparent), 0 0 0 1px var(--c); }
  .md .mcard-top { display: flex; justify-content: space-between; gap: 8px; font: 500 12px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--hero-dim); }
  .md .mcard-tag { padding: 3px 9px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--c) 50%, transparent); color: var(--hero-text); }
  .md .mcard h3 { font-size: 1.7rem; letter-spacing: -.04em; line-height: 1; }
  .md .mcard p { color: var(--hero-lead); font-size: 14.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .md .mcard-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font: 500 12px var(--font-mono); color: var(--hero-dim); }
  .md .mcard-go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--c); color: #0b0d10; }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  import { getMe } from '@/scripts/me';
  onPageLoad(async () => {
    const root = document.querySelector<HTMLElement>('[data-md]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const show = (slug: string) => {
      if (!tabs.some((t) => t.dataset.tab === slug)) return;
      tabs.forEach((t) => (t.dataset.tab === slug ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current')));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== slug));
    };
    tabs.forEach((t) => t.addEventListener('click', (e) => {
      e.preventDefault();
      show(t.dataset.tab!);
      history.replaceState(history.state, '', `?faculty=${encodeURIComponent(t.dataset.tab!)}`);
    }));
    // no faculty asked for: a signed-in student starts on their own
    if (!root.dataset.asked) {
      const me = await getMe<{ user: { profile?: { faculty?: string } } | null }>();
      if (me?.user?.profile?.faculty) show(me.user.profile.faculty);
    }
    const q = root.querySelector<HTMLInputElement>('[data-md-q]')!;
    q.addEventListener('input', () => {
      const t = q.value.trim().toLowerCase();
      root.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        const cards = [...g.querySelectorAll<HTMLElement>('[data-card]')];
        let n = 0;
        for (const c of cards) { c.hidden = Boolean(t) && !c.dataset.text!.includes(t); if (!c.hidden) n++; }
        const none = g.querySelector<HTMLElement>('[data-none]');
        if (none) none.hidden = !t || !cards.length || n > 0;
      });
    });
  });
</script>
