---
/**
 * The front door.
 *   Visitors: a hero (what the platform is, Browse all modules, Sign in or create an account, the faculties).
 *   Signed-in students: their modules (from the answers they gave after signing up, /welcome) with their progress
 *   in each, saved on the server under their student ID, and a Continue button to the next lab not done yet.
 *   Staff: every module with how its class is doing, and Open / Edit / Progress / Statistics.
 */
import Base from '@/layouts/Base.astro';
import { hubData } from '@/lib/accounts/hub';
import { ANY_FACULTY } from '@/lib/accounts/core';
import { platform } from '@/site.config';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=120');
const { settings, cards } = await hubData();
const json = JSON.stringify({ faculties: settings.faculties, activeSemester: settings.activeSemester, years: settings.years, cards }).replace(/</g, '\\u003c');
const labCount = cards.reduce((n, c) => n + c.labs, 0);
const inFaculty = (slug: string) => cards.filter((c) => c.faculty === slug || c.faculty === ANY_FACULTY).length;
---
<Base title="Home" description="Every module's labs in one place: open them any time, with your progress saved.">
  <section class="hub" data-hub>
    <script type="application/json" data-hub-data set:html={json} />
    <div class="hub-sky" aria-hidden="true">
      <div class="hub-orb a"></div><div class="hub-orb b"></div><div class="hub-orb c"></div>
      <svg class="hub-rings" viewBox="0 0 600 600"><circle cx="300" cy="300" r="180" /><circle cx="300" cy="300" r="240" /><circle cx="300" cy="300" r="295" /></svg>
    </div>

    <div class="container hub-in">
      <!-- visitors (and the first moment, while the page finds out who is signed in) -->
      <header class="hero" data-hero>
        <p class="hub-k mono"><span class="hub-dot" aria-hidden="true"></span> {settings.activeSemester} is active · every lab is open day and night</p>
        <h1 class="hub-t">Learn by <span>doing</span></h1>
        <p class="hub-sub">{platform.name} puts every module's labs in one place. Open a lab, work through it at your own pace, and watch your progress grow. There is no session to wait for.</p>
        <div class="hero-go">
          <a class="btn btn-primary btn-lg" href="/modules">Browse all modules →</a>
          <a class="hero-btn" href="/login">Sign in</a>
          <a class="hero-btn" href="/login#signup">Create an account</a>
        </div>
        <dl class="hero-facts">
          <div><dt class="mono">Modules</dt><dd>{cards.length}</dd></div>
          <div><dt class="mono">Labs</dt><dd>{labCount}</dd></div>
          <div><dt class="mono">Faculties</dt><dd>{settings.faculties.length}</dd></div>
        </dl>
        <nav class="hero-fac" aria-label="Faculties">
          {settings.faculties.map((f) => (
            <a href={`/modules?faculty=${encodeURIComponent(f.slug)}`}><b>{f.name}</b><small class="mono">{inFaculty(f.slug)} module{inFaculty(f.slug) === 1 ? '' : 's'} →</small></a>
          ))}
        </nav>
      </header>

      <!-- signed-in students -->
      <section class="mine" data-mine hidden>
        <header class="mine-head">
          <p class="hub-k mono" data-mine-hi></p>
          <h1 class="hub-t small">Your <span>modules</span></h1>
          <p class="mine-chips mono" data-mine-chips></p>
        </header>
        <div class="mine-grid" data-mine-grid></div>
        <div class="later" data-later hidden><h2 class="later-h mono">Your modules in other semesters</h2><div class="mine-grid small" data-later-grid></div></div>
        <a class="mine-all mono" href="/modules">Browse all modules →</a>
      </section>

      <!-- staff -->
      <section class="mine" data-staff hidden>
        <header class="mine-head">
          <p class="hub-k mono" data-staff-hi></p>
          <h1 class="hub-t small">Your <span>teaching</span></h1>
          <p class="mine-lead">Every module and how its students are doing. Open it, edit it, or see its progress and statistics.</p>
        </header>
        <div class="mine-grid" data-staff-grid></div>
      </section>
    </div>
  </section>
</Base>

<style is:global>
  .hub { --g1: #c8ff4d; --g2: #7cb1ff; --g3: #b69cff; position: relative; min-height: 100dvh; overflow: hidden; overflow: clip; isolation: isolate; padding: calc(var(--nav-h) + 48px) 0 96px; background: var(--hero-bg); color: var(--hero-text); }
  :root[data-theme='light'] .hub { --g1: #9fd400; --g2: #3d7be0; --g3: #7a5ce0; }
  .hub-sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hub-orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; animation: hub-float 16s ease-in-out infinite; }
  .hub-orb.a { width: 520px; height: 520px; right: -120px; top: -160px; background: radial-gradient(circle, color-mix(in oklab, var(--g1) 70%, transparent), transparent 65%); }
  .hub-orb.b { width: 460px; height: 460px; left: -160px; top: 30%; background: radial-gradient(circle, color-mix(in oklab, var(--g2) 60%, transparent), transparent 65%); animation-delay: -5s; }
  .hub-orb.c { width: 380px; height: 380px; right: 20%; bottom: -160px; background: radial-gradient(circle, color-mix(in oklab, var(--g3) 55%, transparent), transparent 65%); animation-delay: -9s; }
  :root[data-theme='light'] .hub-orb { opacity: .35; }
  @keyframes hub-float { 50% { transform: translate(30px, -24px) scale(1.06); } }
  .hub-rings { position: absolute; width: 760px; right: -220px; top: -120px; opacity: .5; animation: hub-spin 60s linear infinite; }
  .hub-rings circle { fill: none; stroke: var(--hero-line); stroke-width: 1; stroke-dasharray: 2 10; }
  @keyframes hub-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hub-orb, .hub-rings, .hub-dot { animation: none !important; } }

  .hub-in { display: grid; gap: 36px; }
  .hub-k { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--hero-lead); }
  .hub-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hero-accent); box-shadow: 0 0 12px var(--hero-accent); animation: pulse-ring 2s infinite; }
  .hub-t { margin-top: 18px; font-size: clamp(3rem, 1.4rem + 6.4vw, 6rem); line-height: .92; letter-spacing: -.04em; font-weight: 700; text-wrap: balance; }
  .hub-t span { color: var(--hero-accent); }
  .hub-t.small { margin-top: 10px; font-size: clamp(2.1rem, 1.3rem + 3.2vw, 3.8rem); line-height: 1; }
  .hub-sub { margin-top: 20px; max-width: 58ch; font-size: var(--fs-md); color: var(--hero-lead); text-wrap: pretty; }

  /* visitors */
  .hero { display: grid; justify-items: start; }
  .hero-go { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .hero-btn { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-text); font-weight: 600; background: color-mix(in oklab, var(--hero-bg) 55%, transparent); backdrop-filter: blur(10px); transition: border-color var(--t-fast), transform var(--t-fast); }
  .hero-btn:hover { border-color: var(--hero-accent); transform: translateY(-2px); }
  .hero-facts { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px 40px; }
  .hero-facts div { display: grid; gap: 4px; }
  .hero-facts dt { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--hero-dim); }
  .hero-facts dd { font: 700 clamp(2rem, 1.4rem + 2vw, 2.8rem)/1 var(--font-display); letter-spacing: -.04em; }
  .hero-fac { margin-top: 36px; width: 100%; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .hero-fac a { display: grid; gap: 6px; padding: 20px 22px; border-radius: 20px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-bg) 50%, transparent); backdrop-filter: blur(12px); transition: border-color var(--t-fast), transform var(--t-fast); }
  .hero-fac a:hover { border-color: var(--hero-accent); transform: translateY(-3px); }
  .hero-fac b { font-size: 1.15rem; letter-spacing: -.02em; }
  .hero-fac small { font-size: 12px; color: var(--hero-accent); letter-spacing: .04em; }
  .hub.is-in .hero { display: none; }

  /* students and staff */
  .mine { display: grid; gap: 24px; }
  .mine-head { display: grid; gap: 6px; }
  .mine-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; font-size: 13px; color: var(--hero-lead); }
  .mine-chips > span + span::before { content: '·'; margin: 0 8px; color: var(--hero-dim); }
  .mine-chips a { margin-left: 14px; color: var(--hero-accent); text-decoration: underline; text-underline-offset: 4px; }
  .mine-lead { max-width: 60ch; color: var(--hero-lead); }
  .mine-all { justify-self: start; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--hero-accent); }
  .mine-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
  .mine-none { padding: 28px; border-radius: 20px; border: 1px dashed var(--hero-line); color: var(--hero-lead); }
  .mcard { --c: var(--g1); position: relative; display: grid; gap: 12px; align-content: start; min-height: 240px; padding: 26px; border-radius: 24px; overflow: hidden; color: var(--hero-text); isolation: isolate;
    border: 1px solid color-mix(in oklab, var(--c) 35%, var(--hero-line)); background: color-mix(in oklab, var(--hero-bg) 50%, transparent); backdrop-filter: blur(14px);
    transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out), border-color 300ms; animation: mcard-in .6s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes mcard-in { from { opacity: 0; transform: translateY(18px); } }
  @media (prefers-reduced-motion: reduce) { .mcard { animation: none; } }
  .mcard::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--c) 50%, transparent), transparent 65%); z-index: -1; opacity: .55; transition: opacity 300ms; }
  .mcard:hover { transform: translateY(-6px); border-color: var(--c); box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--c) 70%, transparent), 0 0 0 1px var(--c); }
  .mcard:hover::after { opacity: .9; }
  .mcard-top { display: flex; justify-content: space-between; gap: 8px; font: 500 12px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--hero-dim); }
  .mcard-tag { padding: 3px 9px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--c) 50%, transparent); color: var(--hero-text); }
  .mcard h3 { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem); letter-spacing: -.04em; line-height: 1; }
  .mcard-foot { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; font: 500 12px var(--font-mono); color: var(--hero-dim); }
  .mine-grid.small .mcard { min-height: 0; padding: 20px; }
  .mine-grid.small .mcard h3 { font-size: 1.3rem; }
  .later { display: grid; gap: 14px; }
  .later-h { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--hero-lead); }
  .later .mcard { opacity: .72; }

  /* progress on a card: a bar, and "3 of 5 labs done" */
  .mprog { display: grid; gap: 8px; }
  .mprog-bar { position: relative; height: 8px; border-radius: 99px; background: color-mix(in oklab, var(--hero-text) 10%, transparent); overflow: hidden; }
  .mprog-bar i { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: var(--c); box-shadow: 0 0 12px color-mix(in oklab, var(--c) 60%, transparent); transition: width .8s var(--ease-out); }
  .mprog-t { font-size: 12.5px; color: var(--hero-lead); }
  .mprog-t b { color: var(--hero-text); }
  /* buttons sit above the card's own link */
  .mcard-go, .mcard-tools a { position: relative; z-index: 2; }
  .mcard > * { min-width: 0; }
  .mcard-go { display: inline-flex; align-items: center; gap: 8px; flex: 1 1 auto; min-width: 0; max-width: 100%; height: 40px; padding: 0 16px; border-radius: 999px; background: var(--c); color: #0b0d10; font: 600 13px var(--font-body); }
  .mcard-go span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mcard-tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .mcard-tools a { padding: 8px 12px; border-radius: 10px; border: 1px solid var(--hero-line); color: var(--hero-text); font: 500 12px var(--font-mono); background: color-mix(in oklab, var(--hero-bg) 40%, transparent); }
  .mcard-tools a:hover { border-color: var(--c); }
  .mcard-tools a.pri { background: var(--c); border-color: var(--c); color: #0b0d10; font-weight: 600; }
</style>

<script>
  import { GENERAL, facultyOfProfile, fitsStudent, inSemester, type Faculty, type Semester } from '@/lib/accounts/core';
  import { getMe } from '@/scripts/me';
  type Card = { slug: string; code: string; title: string; term: string; description: string; color: string; href: string; labs: number; builtIn: boolean; category: string; kind: 'core' | 'elective'; open: boolean; years: string[]; specializations: string[]; semester: 'Both' | Semester; faculty: string };
  type Profile = { year: string; specialization: string; modules: string[]; faculty: string };
  type Me = { user: { name: string; role: string; studentId: string | null; profile: Profile } | null; staff: boolean; enrolled: string[]; staffModules: Record<string, string>; builderModules: string[] };
  type Progress = { percent: number; done: number; labs: number; started: boolean; next: { title: string; href: string } | null };
  type ClassProgress = { students: number; avgPercent: number; labs: number };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const hello = () => { const h = new Date().getHours(); return h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening'; };

  /** a student's module card: progress comes in after the page loads */
  function studentCard(m: Card, i: number) {
    return `<article class="mcard" style="--c:${esc(m.color)};--i:${i}" data-module="${esc(m.slug)}">
      <span class="mcard-top"><span>${esc(m.code || 'Module')}</span><span class="mcard-tag">${esc(m.category)}</span></span>
      <h3><a class="module-card-link" href="${esc(m.href)}">${esc(m.title)}</a></h3>
      <div class="mprog"><span class="mprog-bar"><i style="width:0%"></i></span><span class="mprog-t mono" data-prog-t>${m.labs ? 'Loading your progress…' : 'No labs yet'}</span></div>
      <span class="mcard-foot"><span>${m.labs} lab${m.labs === 1 ? '' : 's'}${m.term ? ` · ${esc(m.term)}` : ''}</span><a class="mcard-go" data-go href="${esc(m.href)}"><span>Open module</span> →</a></span>
    </article>`;
  }

  /** a module for staff: how its class is doing, and the tools for it */
  function staffCard(m: Card, i: number, canBuild: boolean) {
    const edit = m.builtIn ? '/admin/cms' : `/admin/builder/${encodeURIComponent(m.slug)}`;
    return `<article class="mcard" style="--c:${esc(m.color)};--i:${i}" data-module="${esc(m.slug)}">
      <span class="mcard-top"><span>${esc(m.code || 'Module')}</span><span class="mcard-tag">${m.labs} lab${m.labs === 1 ? '' : 's'}</span></span>
      <h3><a class="module-card-link" href="${esc(m.href)}">${esc(m.title)}</a></h3>
      <div class="mprog"><span class="mprog-bar"><i style="width:0%"></i></span><span class="mprog-t mono" data-prog-t>Loading the class…</span></div>
      <span class="mcard-tools">
        <a class="pri" href="${esc(m.href)}">Open</a>
        ${canBuild || m.builtIn ? `<a href="${edit}">Edit</a>` : ''}
        <a href="/admin/progress?module=${encodeURIComponent(m.slug)}">Progress</a>
        <a href="/admin/stats?module=${encodeURIComponent(m.slug)}">Statistics</a>
      </span>
    </article>`;
  }

  async function init() {
    const root = document.querySelector<HTMLElement>('[data-hub]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const data = JSON.parse(root.querySelector('[data-hub-data]')!.textContent!) as { faculties: Faculty[]; activeSemester: Semester; years: string[]; cards: Card[] };
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const me = (await getMe<Me>()) ?? null;
    if (!me?.user && !me?.staff) return; // visitors keep the hero

    // staff (and the admin password): every module, with how its class is doing
    if (me.staff && me.user?.role !== 'student') {
      root.classList.add('is-in');
      $('[data-staff]').hidden = false;
      $('[data-staff-hi]').textContent = `${hello()}${me.user ? `, ${me.user.name.split(' ')[0]}` : ''} · ${data.activeSemester} is active`;
      const builders = new Set(me.builderModules ?? []);
      const order = (c: Card) => { const i = data.faculties.findIndex((f) => f.slug === c.faculty); return i < 0 ? data.faculties.length : i; };
      const cards = [...data.cards].sort((a, b) => order(a) - order(b) || a.title.localeCompare(b.title));
      $('[data-staff-grid]').innerHTML = cards.map((m, i) => staffCard(m, i, builders.has(m.slug))).join('');
      const r = await fetch('/api/progress/overview', { cache: 'no-store' }).then((x) => (x.ok ? x.json() : null)).catch(() => null);
      const classes = (r?.modules ?? {}) as Record<string, ClassProgress>;
      root.querySelectorAll<HTMLElement>('[data-staff-grid] [data-module]').forEach((el) => {
        const c = classes[el.dataset.module!];
        el.querySelector<HTMLElement>('.mprog-bar i')!.style.width = `${c?.avgPercent ?? 0}%`;
        el.querySelector('[data-prog-t]')!.innerHTML = !r ? 'Could not load the class right now.'
          : c?.students ? `<b>${c.students}</b> student${c.students === 1 ? '' : 's'} started · average <b>${c.avgPercent}%</b>` : 'No student has started yet.';
      });
      return;
    }

    // students: the answers they gave after signing up decide their modules; none yet → the setup step first
    const user = me.user!;
    const p = user.profile;
    if (!p?.year) return void location.replace('/welcome?next=/');
    root.classList.add('is-in');
    $('[data-mine]').hidden = false;
    const profile: Profile = { ...p, faculty: data.faculties.length > 1 ? facultyOfProfile(p) : data.faculties[0]?.slug ?? facultyOfProfile(p) };
    $('[data-mine-hi]').textContent = `${hello()}, ${user.name.split(' ')[0]} · ${data.activeSemester} is active`;
    const faculty = data.faculties.find((f) => f.slug === profile.faculty)?.name;
    $('[data-mine-chips]').innerHTML = [...(data.faculties.length > 1 && faculty ? [faculty] : []), profile.year, profile.specialization === GENERAL ? 'General' : profile.specialization]
      .filter(Boolean).map((t) => `<span>${esc(t)}</span>`).join('') + '<a href="/account#studies">Change answers</a>';
    // core modules for their faculty, year and specialization, the optional ones they chose, and any they are in
    const forMe = (m: Card) => profile.modules.includes(m.slug) || (me.enrolled ?? []).includes(m.slug) || (m.kind === 'core' && fitsStudent(m, profile));
    const all = data.cards.filter(forMe);
    const now = all.filter((m) => inSemester(m, data.activeSemester));
    const later = all.filter((m) => !inSemester(m, data.activeSemester));
    $('[data-mine-grid]').innerHTML = now.length ? now.map(studentCard).join('')
      : '<p class="mine-none">No modules match your answers for this semester yet. <a href="/modules">Browse all modules</a> or <a href="/account#studies">change your answers</a>.</p>';
    $('[data-later]').hidden = !later.length;
    $('[data-later-grid]').innerHTML = later.map(studentCard).join('');

    // progress from the server (the same scores the TA sees), so it is right on any device
    const r = await fetch('/api/progress/mine', { cache: 'no-store' }).then((x) => (x.ok ? x.json() : null)).catch(() => null);
    const progress = (r?.modules ?? {}) as Record<string, Progress>;
    root.querySelectorAll<HTMLElement>('[data-mine] [data-module]').forEach((el) => {
      const card = data.cards.find((c) => c.slug === el.dataset.module);
      const m = progress[el.dataset.module!];
      const text = el.querySelector('[data-prog-t]')!;
      const go = el.querySelector<HTMLAnchorElement>('[data-go]')!;
      if (!card?.labs) return;
      if (!r) { text.textContent = 'Could not load your progress right now.'; return; }
      el.querySelector<HTMLElement>('.mprog-bar i')!.style.width = `${m?.percent ?? 0}%`;
      text.innerHTML = m?.started ? `<b>${m.done} of ${m.labs}</b> lab${m.labs === 1 ? '' : 's'} done · <b>${m.percent}%</b> of the work` : 'Not started yet';
      if (m?.next) {
        go.href = m.next.href;
        // builder labs are titled "Module: Lab"; the card already says the module
        const lab = m.next.title.startsWith(`${card.title}: `) ? m.next.title.slice(card.title.length + 2) : m.next.title;
        go.querySelector('span')!.textContent = `${m.started ? 'Continue' : 'Start'}: ${lab}`;
      } else if (m?.labs) go.querySelector('span')!.textContent = 'All labs done · review';
    });
  }
  const initPage = () => void init();
  document.addEventListener('astro:page-load', initPage);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPage, { once: true });
  else initPage();
</script>
