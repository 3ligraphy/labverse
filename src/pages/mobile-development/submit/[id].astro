---
/** A Mobile Development hand-in (the course project): the shared hand-in page, with the course's trail. */
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import HandIn from '@/components/project/HandIn.astro';
import { COURSE_MODULE, submitHref } from '@/lib/project-files/core';
import { getFilesStore } from '@/lib/project-files/server';
import { isAdmin } from '@/lib/attendance/server';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

const store = getFilesStore();
const file = store ? await store.get(Astro.params.id ?? '').catch(() => null) : null;
// another module's item opens on that module's page
if (file && file.module !== COURSE_MODULE) return Astro.redirect(submitHref(file), 302);
if (!file) Astro.response.status = 404;
---
<Base title={file ? file.title : 'Submission not found'} description={file?.description || undefined} noindex>
  {!file ? (
    <div class="container" style="padding-block: 160px 120px">
      <EmptyState title="This submission doesn't exist." body="It may have been removed. Check the Course Project page for what's open." path="project/" />
    </div>
  ) : (
    <HandIn file={file} admin={isAdmin(Astro.cookies)} crumbs={[{ label: 'Mobile Development', href: '/mobile-development' }, { label: 'Project', href: '/mobile-development/project#files' }]} />
  )}
</Base>
