<script>
  import { initLab } from '@/scripts/wireless-lab';
  import { initSheet2 } from '@/scripts/wireless-sheet2';
  import { onPageLoad } from '@/scripts/page-load';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-wireless]');
    if (!root || root.dataset.wired) return;
    initLab(root, { key: 'buenova:wireless-sheet2', resetPrompt: 'Reset all Wireless Sheet 2 progress in this browser?' });
    initSheet2(document);
  });
</script>
