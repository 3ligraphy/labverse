---
/** A builder module: its description and labs in the order set on the module canvas. */
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import { isAdmin } from '@/lib/attendance/server';
import Locked from '@/components/platform/Locked.astro';
import { moduleAccess } from '@/lib/accounts/enrolment';
import SplitBar from '@/components/SplitBar.astro';
import { loadModule } from '@/lib/platform/server';
import { moduleAssessment } from '@/lib/platform/assessment';
import PsychologyWorkspace from '@/components/platform/PsychologyWorkspace.astro';
import { moduleSections, moduleSectionHref, PSYCHOLOGY_MODULE } from '@/lib/platform/module-sections';
import { labKey } from '@/lib/platform/core';

export const prerender = false;
const preview = isAdmin(Astro.cookies) && Astro.url.searchParams.has('preview');
// invitation-only: depends on who is viewing, so never cached publicly
Astro.response.headers.set('cache-control', 'private, no-store');
const data = await loadModule(Astro.params.module ?? '', { drafts: preview }).catch(() => null);
const gate = data ? await moduleAccess(Astro.cookies, data.module.slug) : { ok: false, signedIn: false };
if (!data) Astro.response.status = 404;
const color = data?.meta.color || '#7cb1ff';
// set by the module leader in /admin/assessment/<module>
const assessment = data ? (await moduleAssessment(data.module.slug)).items : [];
const pad = (n: number) => String(n).padStart(2, '0');
let lastWeek = '';
const firstLab = data?.items[0];
const taskCount = data?.items.reduce((sum, item) => sum + item.compiled.blocks.filter((b) => b.kind === 'task').length, 0) ?? 0;
const weeks = new Set(data?.items.map((item) => item.week).filter(Boolean));
const labHref = (slug: string) => `/m/${data!.module.slug}/${slug}${preview ? '?preview' : ''}`;
const sections = moduleSections(Astro.params.module ?? '');
const requestedTab = Astro.url.searchParams.get('tab') ?? 'overview';
const activeTab = sections.some((s) => s.toLowerCase() === requestedTab) ? requestedTab : 'overview';
const psychology = data?.module.slug === PSYCHOLOGY_MODULE;
const sectionHref = (section: string) => moduleSectionHref(Astro.params.module ?? '', section, preview);
---
<Base title={data ? data.meta.title || data.module.title : 'Module not found'} description={data?.meta.description} module={data ? { slug: data.module.slug, title: data.meta.title || data.module.title, color } : undefined}>
  {data && !gate.ok ? (
    <Locked title={data.meta.title || data.module.title} code={data.meta.code} color={color} description={data.meta.description} signedIn={gate.signedIn} next={Astro.url.pathname} />
  ) : !data ? (
    <div class="container" style="padding-block: 160px 120px">
      <h1 class="sr-only">Module not found</h1>
      <EmptyState title="This module isn't available." body="It may not be published yet." path="modules/" />
    </div>
  ) : (
    <>
      <header class="mdh" style={`--c:${color}`}>
        <div class="mdh-bg" aria-hidden="true"></div>
        <div class="container">
          <nav class="crumbs" aria-label="Breadcrumb"><a href="/">~</a><span aria-hidden="true">/</span><a href="/modules">modules</a><span aria-hidden="true">/</span><span aria-current="page">{data.module.slug}</span></nav>
          {preview && <p class="mdh-prev mono">Admin preview · drafts included</p>}
          <div class="mdh-grid"><div class="mdh-copy">
          <p class="mdh-k mono"><span class="mdh-dot" aria-hidden="true"></span>{[data.meta.code, data.meta.term].filter(Boolean).join(' · ') || 'Your learning space'}</p>
          <h1 class="mdh-t">{data.meta.title || data.module.title}</h1>
          {data.meta.description && <p class="lead mdh-l">{data.meta.description}</p>}
          <div class="mdh-actions">
            {firstLab && <a class="mdh-start" href={labHref(firstLab.lab.slug)}>Start learning <span aria-hidden="true">↗</span></a>}
            <a class="mdh-browse" href={`${sectionHref('labs')}#workspace`}>Explore the labs <span aria-hidden="true">↓</span></a>
          </div>
          <div class="mdh-stats">
            <div><b>{pad(data.items.length)}</b><span>Practical labs</span></div>
            <div><b>{pad(taskCount)}</b><span>Hands-on tasks</span></div>
            <div><b>{weeks.size ? pad(weeks.size) : '↗'}</b><span>{weeks.size ? 'Learning stages' : 'Learn by doing'}</span></div>
          </div>
          </div>
          <aside class="mdh-feature" aria-label="Your starting point">
            <div class="mdh-orbit" aria-hidden="true"><span></span><b>01</b><i>EXPLORE / CREATE / LEARN</i></div>
            <div class="mdh-feature-copy"><p class="mono">YOUR STARTING POINT</p>
              <h2>{firstLab ? firstLab.compiled.meta.title : 'Something good is taking shape.'}</h2>
              <p>{firstLab ? [firstLab.week, firstLab.compiled.meta.estimatedTime, firstLab.compiled.meta.difficulty].filter(Boolean).join(' · ') || 'A little curiosity. A lot of possibility.' : 'Your teaching team will publish the first lab here.'}</p>
              {firstLab && <a href={labHref(firstLab.lab.slug)}>Open the first lab <span aria-hidden="true">→</span></a>}
            </div>
          </aside></div>
        </div>
      </header>

      <div class="container module-workspace" id="workspace" style={`--module-color:${color}`}>
        <nav class="module-tabs" aria-label="Module sections">{sections.map((section) => <a href={`${sectionHref(section)}#workspace`} aria-current={activeTab === section.toLowerCase() ? 'page' : undefined}>{section}</a>)}</nav>
        {psychology && activeTab !== 'labs' && activeTab !== 'assessment' && <PsychologyWorkspace section={activeTab} />}
        {!psychology && activeTab === 'overview' && <div class="module-intro"><h2>Your module workspace</h2><p>Follow the practical labs in order and use the task checkboxes to keep track of your learning.</p><a class="btn btn-primary" href={`${sectionHref('labs')}#workspace`}>Explore the labs →</a></div>}
      </div>
      {activeTab === 'assessment' && (
        <section class="container mda" id="assessment">
          <h2>Assessment</h2>
          {assessment.length ? <SplitBar items={assessment.map((a) => ({ label: a.label, value: a.weight, sub: a.detail }))} size="md" /> : <p class="muted">Your module leader has not published the assessment breakdown yet. Keep working through the labs; grading and submission details will appear here when available.</p>}
        </section>
      )}

      {activeTab === 'labs' &&
      <section class="container mdl" id="labs">
        <div class="mdl-heading"><div><p class="mono mdh-k">THE LEARNING PATH</p><h2>Build your understanding.<br /><span>One lab at a time.</span></h2></div><p>Follow the labs in order. Explore the ideas,<br />try them yourself, and make them yours.</p></div>
        {data.items.length === 0 && <EmptyState title="No labs yet." body="Labs appear here once they are published." path={`m/${data.module.slug}/`} />}
        <ol class="mdl-list">
          {data.items.map(({ lab, compiled, week, n }) => {
            const tasks = compiled.blocks.filter((b) => b.kind === 'task').length;
            const exercises = Object.values(compiled.exercises).filter((e) => e.checks.length).length;
            const heading = week && week !== lastWeek ? week : '';
            lastWeek = week || lastWeek;
            return (
              <>
                {heading && <li class="mdl-week mono" aria-hidden="true">{heading}</li>}
                <li>
                  <a class="lab" href={labHref(lab.slug)} style={`--c:${color}`}>
                    <span class="lab-n mono">LAB<b>{lab.slug.match(/^lab-(\d+)$/)?.[1]?.padStart(2, '0') ?? pad(n)}</b></span>
                    <span class="lab-main">
                      <span class="lab-t">{compiled.meta.title}{!lab.published && <span class="lab-draft mono">draft</span>}</span>
                      {compiled.meta.description && <span class="lab-d">{compiled.meta.description}</span>}
                      <span class="lab-m mono">{[compiled.meta.difficulty, compiled.meta.estimatedTime, `${tasks} task${tasks === 1 ? '' : 's'}`, exercises ? `${exercises} graded exercise${exercises === 1 ? '' : 's'}` : ''].filter(Boolean).join(' · ')}</span>
                      <span class="session-progress" data-session-progress={labKey(data.module.slug, lab.slug)} data-task-ids={JSON.stringify(compiled.blocks.filter((b) => b.kind === 'task').map((b) => b.kind === 'task' ? b.n : ''))}>
                        <span class="session-progress-label"><span data-progress-label>{tasks ? 'Task progress · saved in this browser' : 'Reading session · no tracked tasks'}</span><b data-progress-percent></b></span>
                        <progress max={tasks || 1} value="0" aria-label={`Task completion for ${compiled.meta.title}`} hidden={!tasks}></progress>
                      </span>
                    </span>
                    <span class="lab-go" aria-hidden="true">↗</span>
                  </a>
                </li>
              </>
            );
          })}
        </ol>
      </section>}
    </>
  )}
</Base>

<style>
  .module-workspace { scroll-margin-top: calc(var(--nav-h) + 20px); }
  .module-tabs { display: flex; gap: 6px; overflow-x: auto; border-bottom: 1px solid var(--line-2); padding-block: 20px 12px; }
  .module-tabs a { flex-shrink: 0; padding: 11px 16px; border-radius: 9px; font-size: 13px; color: var(--text-2); }
  .module-tabs a[aria-current] { color: var(--text); background: color-mix(in oklab, var(--module-color) 18%, var(--surface)); box-shadow: inset 0 -2px var(--module-color); }
  .module-tabs a:hover { background: var(--surface); }
  .module-intro { padding-block: 45px 80px; display: grid; gap: 20px; justify-items: start; }
  .session-progress { display: grid; gap: 8px; margin-top: 16px; max-width: 520px; }
  .session-progress-label { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: var(--text-3); }
  .session-progress-label b { color: var(--text); }
  .session-progress progress { appearance: none; width: 100%; height: 6px; border: 0; border-radius: 99px; overflow: hidden; background: var(--line-2); }
  .session-progress progress::-webkit-progress-bar { background: var(--line-2); border-radius: 99px; }
  .session-progress progress::-webkit-progress-value { background: var(--c); border-radius: 99px; }
  .session-progress progress::-moz-progress-bar { background: var(--c); border-radius: 99px; }
  .mdh { position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--nav-h) + 32px) 0 64px; border-bottom: 1px solid var(--line); }
  .mdh-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, 1fr); gap: clamp(32px, 6vw, 100px); align-items: center; margin-top: 32px; }
  .mdh-copy { min-width: 0; }
  .mdh-dot { display: inline-block; width: 7px; height: 7px; margin-right: 10px; background: var(--c); border-radius: 50%; box-shadow: 0 0 0 5px color-mix(in oklab, var(--c) 15%, transparent); }
  .mdh-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 30px; }
  .mdh-start { display: flex; gap: 32px; align-items: center; background: var(--c); color: #11171d; border-radius: 12px; padding: 16px 22px; font-weight: 650; }
  .mdh-start:hover { filter: brightness(1.08); }
  .mdh-browse { font-size: 14px; color: var(--text-2); }
  .mdh-browse span { margin-left: 10px; }
  .mdh-stats { display: flex; gap: clamp(20px, 4vw, 56px); border-top: 1px solid var(--line-2); margin-top: 42px; padding-top: 22px; }
  .mdh-stats div { display: grid; gap: 4px; }
  .mdh-stats b { font: 500 30px var(--font-display); letter-spacing: -.04em; }
  .mdh-stats span { font-size: 12px; color: var(--text-3); }
  .mdh-feature { border: 1px solid color-mix(in oklab, var(--c) 30%, var(--line)); border-radius: 24px; overflow: hidden; background: var(--surface); transform: rotate(2deg); box-shadow: 0 24px 65px -40px color-mix(in oklab, var(--c) 50%, transparent); }
  .mdh-orbit { position: relative; display: grid; place-items: center; height: 260px; overflow: hidden; background: #131c23; color: var(--c); }
  .mdh-orbit::before, .mdh-orbit::after, .mdh-orbit span { content: ''; position: absolute; width: 230px; height: 230px; border: 1px solid color-mix(in oklab, var(--c) 45%, transparent); border-radius: 50%; transform: rotate(-30deg) scaleX(1.5); }
  .mdh-orbit::after { transform: rotate(40deg) scaleX(.7); }
  .mdh-orbit span { transform: rotate(-45deg) scaleX(.45); }
  .mdh-orbit b { font: 500 116px var(--font-display); letter-spacing: -.08em; z-index: 1; }
  .mdh-orbit i { position: absolute; bottom: 17px; font: normal 10px var(--font-mono); letter-spacing: .18em; }
  .mdh-feature-copy { padding: 26px; }
  .mdh-feature-copy > .mono { font-size: 10px; letter-spacing: .15em; color: var(--text-3); }
  .mdh-feature h2 { font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.12; letter-spacing: -.04em; margin-top: 10px; }
  .mdh-feature-copy > p:not(.mono) { margin-top: 14px; color: var(--text-3); font-size: 12px; }
  .mdh-feature a { display: flex; justify-content: space-between; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; font-size: 13px; font-weight: 600; }
  .mdl-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .mdl-heading h2 { font-size: clamp(1.8rem, 3vw, 3rem); letter-spacing: -.05em; line-height: 1.1; margin-top: 10px; }
  .mdl-heading h2 span { color: var(--text-3); }
  .mdl-heading > p { font-size: 14px; color: var(--text-3); }
  .lab:focus-visible, .mdh a:focus-visible { outline: 3px solid var(--c, var(--accent-text)); outline-offset: 5px; }
  @media (max-width: 760px) { .mdh-grid { grid-template-columns: 1fr; } .mdh-feature { transform: none; } .mdh-orbit { height: 190px; } .mdl-heading { align-items: start; flex-direction: column; } }
  @media (max-width: 480px) { .lab { gap: 12px; padding: 18px 14px; } .lab-go { display: none; } .lab { grid-template-columns: auto 1fr; } .mdh-stats { gap: 22px; } }
  .mdh-bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 90% -10%, color-mix(in oklab, var(--c) 40%, transparent), transparent 50%), radial-gradient(var(--grid-dot) 1px, transparent 1px) 0 0 / 22px 22px; }
  .mdh-prev { margin-top: 18px; display: inline-block; padding: 4px 10px; border-radius: 999px; background: var(--warn-soft); color: var(--warn); font-size: 12px; }
  .mdh-k { margin-top: 24px; font-size: 12px; color: var(--text-3); }
  .mdh-t { margin-top: 10px; font-size: clamp(2.4rem, 1.3rem + 4.5vw, 5rem); letter-spacing: -.05em; line-height: .95; font-weight: 700; max-width: 18ch; }
  .mdh-l { margin-top: 18px; max-width: 60ch; }
  .mdh-n { margin-top: 22px; font-size: 12px; color: var(--text-3); }
  .mdh-n b { color: var(--text); font-size: 15px; }
  .mdl { padding-block: 36px 120px; }
  .mda { padding-block: 44px 100px; display: grid; gap: 20px; }
  .mdl-list { list-style: none; padding: 0; display: grid; gap: 14px; }
  .mdl-week { margin-top: 22px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); }
  .lab { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; padding: 26px; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: var(--surface); transition: border-color var(--t-fast), transform var(--t-fast); }
  .lab:hover { border-color: var(--c); transform: translateX(3px); }
  .lab-n { display: grid; font-size: 12px; letter-spacing: .14em; color: var(--text-3); line-height: 1; }
  .lab-n b { font-family: var(--font-display); font-size: 40px; letter-spacing: -.05em; color: var(--text); margin-top: 4px; }
  .lab-main { display: grid; gap: 4px; min-width: 0; }
  .lab-t { font-size: 1.15rem; font-weight: 650; letter-spacing: -.01em; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .lab-draft { font-size: 12px; padding: 2px 7px; border-radius: 999px; background: var(--warn-soft); color: var(--warn); }
  .lab-d { color: var(--text-2); font-size: 14.5px; }
  .lab-m { font-size: 12px; color: var(--text-3); }
  .lab-go { font-size: 20px; color: var(--text-3); }
  @media (max-width: 480px) { .lab { gap: 12px; padding: 18px 14px; grid-template-columns: auto 1fr; } }
</style>
<script>
  import '@/scripts/session-card-progress';
</script>
