---
/**
 * Sign in (doctors, TAs, students) and optional student sign-up with onboarding (year, specialization,
 * optional modules). Students never have to sign in: they can keep typing their name and ID in each lab.
 */
import Base from '@/layouts/Base.astro';
import { hubData } from '@/lib/accounts/hub';
import { getAccountStore, viewer } from '@/lib/accounts/server';
import { ROLE_LABEL } from '@/lib/accounts/core';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

// Older/broken clients could submit the forms as GET requests before the client script was
// wired, placing credentials in the address bar. Strip those values immediately and keep only
// unrelated navigation parameters (for example `next`).
if (Astro.url.searchParams.has('email') || Astro.url.searchParams.has('password')) {
  const clean = new URL(Astro.url);
  clean.searchParams.delete('email');
  clean.searchParams.delete('password');
  return Astro.redirect(`${clean.pathname}${clean.search}`, 303);
}

const store = getAccountStore();
const enabled = Boolean(store);
const { settings, cards } = await hubData();
const optional = cards.filter((c) => c.kind === 'elective' && c.open).map((c) => ({ slug: c.slug, title: c.title, code: c.code, color: c.color, years: c.years, specializations: c.specializations, builtIn: c.builtIn }));
const study = { years: settings.years, activeSemester: settings.activeSemester, specFrom: settings.specFrom };
const next = Astro.url.searchParams.get('next');
const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : '';
const ended = Astro.url.searchParams.has('ended');
// Already signed in: go straight on when the page was opened on the way somewhere (?next=…); otherwise say
// who is signed in instead of showing the sign-in form again.
const claims = viewer(Astro.cookies);
const found = claims && store ? await store.byId(claims.u).catch(() => null) : null;
const me = found?.active ? found : null;
if (me && safeNext && !ended) return Astro.redirect(safeNext, 303);
const json = JSON.stringify({ optional, study, next: safeNext }).replace(/</g, '\\u003c');
---
<Base title="Sign in" noindex>
  <section class="auth" data-auth>
    <script type="application/json" data-auth-data set:html={json} />
    <div class="auth-sky" aria-hidden="true"><div class="auth-orb a"></div><div class="auth-orb b"></div></div>
    <div class="container auth-in">
      <div class="auth-copy">
        <p class="auth-k mono"><span></span> Secure access</p>
        <h1>One account.<br /><em>Every module.</em></h1>
        <ul class="auth-roles">
          <li><b>Super admins &amp; module leaders</b> manage roles, teams and invitations; <b>doctors</b> build modules and labs.</li>
          <li><b>Teaching assistants</b> start lab sessions, take attendance and follow progress.</li>
          <li><b>Students</b> can sign in to skip typing their details, or keep using their name and ID.</li>
        </ul>
        {!me && <a class="auth-skip" href="/">Continue without an account →</a>}
      </div>

      <div class="auth-card glass">
        {me ? (
          <div class="auth-as">
            <h2>You're signed in</h2>
            <p>As <b>{me.name}</b> · {ROLE_LABEL[me.role]}<br /><span class="mono">{me.email}</span></p>
            <a class="btn btn-primary btn-lg" href={me.role === 'student' ? '/' : '/admin'}>Continue →</a>
            <div class="auth-as-more">
              <a class="btn btn-ghost" href="/account">Your profile</a>
              <button class="btn btn-ghost" type="button" data-auth-out>Sign out to use another account</button>
            </div>
          </div>
        ) : !enabled ? (
          <div class="auth-off"><h2>Accounts aren't set up yet</h2><p>This site needs a database and an ADMIN_PASSWORD (or SESSION_SECRET). Staff can still use the <a href="/admin">admin password</a>.</p></div>
        ) : (
          <>
            <div class="auth-tabs" role="tablist">
              <button type="button" role="tab" aria-selected="true" data-tab="in">Sign in</button>
              <button type="button" role="tab" aria-selected="false" data-tab="up">Student sign-up</button>
            </div>
            {ended && <p class="auth-note">Your session ended (the account was changed or disabled). Please sign in again.</p>}

            <form class="auth-form" data-form="in" method="post" action={`/api/auth/login${safeNext ? `?next=${encodeURIComponent(safeNext)}` : ''}`} data-astro-reload novalidate>
              <label><span>BUE email or username</span><input class="input" name="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="name.surname@bue.edu.eg" required /></label>
              <label><span>Password</span><input class="input" type="password" name="password" autocomplete="current-password" required /></label>
              <p class="auth-msg" id="in-msg" data-msg role="alert"></p>
              <button class="btn btn-primary btn-lg" type="submit">Sign in →</button>
              <p class="auth-fine">Staff accounts come from an invitation or from the super admin in <b>Admin → Accounts</b>.</p>
            </form>
            <form class="auth-form" data-form="up" method="post" action="/api/auth/signup" data-astro-reload hidden novalidate>
              <div class="auth-row">
                <label><span>Full name</span><input class="input" name="name" autocomplete="name" required maxlength="60" /></label>
                <label><span>Student ID</span><input class="input mono" name="studentId" required maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
              </div>
              <label><span>University email</span><input class="input" type="email" name="email" autocomplete="email" autocapitalize="none" spellcheck="false" required /></label>
              <label><span>Password <small>(10+ characters, letters and numbers)</small></span><input class="input" type="password" name="password" autocomplete="new-password" required /></label>
              <div class="auth-row auth-study">
                <label><span>Year</span><select class="input" name="year" required><option value="">Choose your year…</option>{settings.years.map((y) => <option>{y}</option>)}</select></label>
                <label data-spec-field hidden><span>Specialization</span><select class="input" name="specialization" disabled><option value="">Choose…</option>{settings.specializations.map((s) => <option>{s}</option>)}</select></label>
              </div>
              <p class="auth-fine auth-spec-note" data-spec-note hidden></p>
              <fieldset class="auth-opts"><legend>Optional modules you chose</legend><div data-up-opts><p class="auth-fine">Choose your year first.</p></div></fieldset>
              <p class="auth-msg" id="up-msg" data-msg role="alert"></p>
              <button class="btn btn-primary btn-lg" type="submit">Create account →</button>
            </form>
          </>
        )}
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .auth { --g1: #c8ff4d; --g2: #7cb1ff; position: relative; min-height: 100dvh; overflow: hidden; overflow: clip; isolation: isolate; padding: calc(var(--nav-h) + 56px) 0 80px; background: var(--hero-bg); color: var(--hero-text); }
  :root[data-theme='light'] .auth { --g1: #9fd400; --g2: #3d7be0; }
  .auth-sky { position: absolute; inset: 0; z-index: -1; }
    .auth-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .5; }
  .auth-orb.a { width: 520px; height: 520px; left: -160px; top: -120px; background: radial-gradient(circle, color-mix(in oklab, var(--g1) 60%, transparent), transparent 65%); }
  .auth-orb.b { width: 520px; height: 520px; right: -160px; bottom: -200px; background: radial-gradient(circle, color-mix(in oklab, var(--g2) 60%, transparent), transparent 65%); }
  .auth-in { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .auth-in { grid-template-columns: 1fr 520px; gap: 72px; } }
  /* phones and tablets: the form first, the explanation of roles after it */
  @media (max-width: 999px) { .auth-card { order: -1; } .auth-in { gap: 32px; } }
  .auth-k { display: inline-flex; gap: 10px; align-items: center; font-size: 12px; color: var(--hero-accent); }
  .auth-k span { width: 8px; height: 8px; border-radius: 50%; background: var(--hero-accent); box-shadow: 0 0 12px var(--hero-accent); }
  .auth-copy h1 { margin-top: 18px; font-size: clamp(2.6rem, 1.4rem + 4.5vw, 5.4rem); line-height: .95; letter-spacing: -.05em; }
  .auth-copy em { font-style: normal; color: var(--hero-accent); }
  .auth-roles { list-style: none; padding: 0; margin-top: 28px; display: grid; gap: 12px; max-width: 52ch; color: var(--hero-lead); }
  .auth-roles li { padding-left: 18px; border-left: 2px solid var(--hero-line); }
  .auth-roles b { color: var(--hero-text); }
  .auth-skip { display: inline-block; margin-top: 26px; color: var(--hero-accent); font-weight: 600; }
  .auth-card { padding: clamp(22px, 4vw, 34px); display: grid; gap: 18px; }
  .auth-tabs { display: grid; grid-template-columns: repeat(2, 1fr); padding: 4px; border-radius: 14px; background: color-mix(in oklab, var(--hero-text) 6%, transparent); }
  .auth-tabs button { padding: 10px; border: 0; border-radius: 11px; background: none; color: var(--hero-lead); font: 600 13.5px var(--font-body); cursor: pointer; }
  .auth-tabs button[aria-selected='true'] { background: var(--hero-accent); color: var(--hero-bg); box-shadow: 0 6px 20px -8px var(--hero-accent); }
  .auth-form { display: grid; gap: 14px; }
  .auth-form label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: var(--hero-text); }
  .auth-form small { color: var(--hero-dim); font-weight: 400; }
  .auth-form .input { height: 46px; background-color: color-mix(in oklab, var(--hero-bg) 70%, transparent); border-color: var(--hero-line); color: var(--hero-text); }
  .auth-form .input:hover:not(:focus) { border-color: var(--hero-dim); }
  .auth-form .input:focus { border-color: var(--hero-accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--hero-accent) 20%, transparent); }
  .auth-form .input[aria-invalid='true'] { border-color: var(--hero-danger); }
  .auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  /* before the specialization year the year takes the whole row */
  .auth-study:has([data-spec-field][hidden]) { grid-template-columns: 1fr; }
  .auth-spec-note { margin-top: -4px; }
  @media (max-width: 520px) { .auth-row { grid-template-columns: 1fr; } }
  .auth-opts { border: 1px solid var(--hero-line); border-radius: 14px; padding: 12px 14px; }
  .auth-opts legend { padding: 0 6px; font-size: 13px; font-weight: 600; }
  .auth-opts [data-up-opts] { display: grid; gap: 8px; }
  .auth-form .auth-opt { display: flex; gap: 10px; align-items: center; font-weight: 400; cursor: pointer; }
  .auth-opt input { accent-color: var(--hero-accent); }
  .auth-msg { min-height: 18px; font-size: 13px; color: var(--hero-danger); }
  .auth-note { padding: 10px 12px; border-radius: 12px; background: color-mix(in oklab, var(--hero-warn) 16%, transparent); color: var(--hero-warn); font-size: 13px; }
  .auth-fine { font-size: 12.5px; color: var(--hero-dim); }
  .auth-fine a, .auth-off a { color: var(--hero-accent); }
  .auth-off p { margin-top: 8px; color: var(--hero-lead); }
  .auth-as { display: grid; gap: 14px; }
  .auth-as p { color: var(--hero-lead); line-height: 1.5; }
  .auth-as p b { color: var(--hero-text); }
  .auth-as-more { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { GENERAL } from '@/lib/accounts/core';
  import { wireStudyFields, type StudyConfig } from '@/scripts/study-fields';
  type Opt = { slug: string; title: string; code: string; color: string; years: string[]; specializations: string[]; builtIn: boolean };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const has = (list: string[], v: string) => !list.length || list.some((x) => x.toLowerCase() === v.toLowerCase());

  /** Empty required fields are marked and announced before anything is sent; true when all are filled. */
  const filled = (form: HTMLFormElement, msg: HTMLElement): boolean => {
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const empty = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')].filter((el) => !el.value.trim());
    if (!empty.length) return true;
    for (const el of empty) { el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', msg.id); }
    const name = (el: Element) => el.closest('label')?.querySelector('span')?.firstChild?.textContent?.trim().toLowerCase() ?? 'this field';
    msg.textContent = empty.length === 1 ? `Fill in your ${name(empty[0])}.` : `Fill in the ${empty.length} highlighted fields.`;
    empty[0].focus();
    return false;
  };

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-auth]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const data = JSON.parse(root.querySelector('[data-auth-data]')!.textContent!) as { optional: Opt[]; study: StudyConfig; next: string };
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const show = (t: string) => {
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
      root.querySelectorAll<HTMLElement>('[data-form]').forEach((f) => (f.hidden = f.dataset.form !== t));
    };
    tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
    root.querySelector('[data-auth-out]')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.reload();
    });
    if (location.hash === '#signup') show('up');

    const done = (role: string) => {
      try { localStorage.removeItem('mdx:profile'); } catch { /* ignore */ }
      location.href = data.next || (role === 'student' ? '/' : '/admin');
    };

    const signin = root.querySelector<HTMLFormElement>('[data-form="in"]');
    signin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = signin.querySelector<HTMLElement>('[data-msg]')!;
      const fd = new FormData(signin);
      msg.textContent = '';
      if (!filled(signin, msg)) return;
      const r = await fetch('/api/auth/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { msg.textContent = d.error ?? 'Could not sign in.'; return; }
      done(d.user.role);
    });

    const signup = root.querySelector<HTMLFormElement>('[data-form="up"]');
    if (!signup) return;
    const box = signup.querySelector<HTMLElement>('[data-up-opts]')!;
    // "General" students (before the specialization year) match only modules open to every specialization
    const fitsSpec = (o: Opt, s: string) => !o.specializations.length || (s !== GENERAL && has(o.specializations, s));
    const renderOpts = () => {
      const y = study.year(), s = study.specialization();
      if (!y || !s) { box.innerHTML = `<p class="auth-fine">${y ? 'Choose your specialization first.' : 'Choose your year first.'}</p>`; return; }
      // keep what was ticked; the built-in course starts ticked (almost every student takes it)
      const ticked = new Set([...box.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value));
      const fresh = !box.querySelector('input');
      const list = data.optional.filter((o) => has(o.years, y) && fitsSpec(o, s));
      box.innerHTML = list.length
        ? list.map((o) => `<label class="auth-opt"><input type="checkbox" name="modules" value="${esc(o.slug)}"${ticked.has(o.slug) || (fresh && o.builtIn) ? ' checked' : ''} /> <span>${esc(o.title)}${o.code ? ` <small>${esc(o.code)}</small>` : ''}</span></label>`).join('')
        : '<p class="auth-fine">No optional modules for this year yet.</p>';
    };
    const study = wireStudyFields(signup, data.study, renderOpts);
    renderOpts();
    signup.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = signup.querySelector<HTMLElement>('[data-msg]')!;
      msg.textContent = '';
      if (!filled(signup, msg)) return;
      const fd = new FormData(signup);
      const body = { name: fd.get('name'), studentId: fd.get('studentId'), email: fd.get('email'), password: fd.get('password'), year: fd.get('year'), specialization: fd.get('specialization'), modules: fd.getAll('modules') };
      const r = await fetch('/api/auth/signup', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { msg.textContent = d.error ?? 'Could not create the account.'; return; }
      done('student');
    });
  };

  // Page scripts may be evaluated after Astro's initial `astro:page-load` event. Initialise
  // immediately when the DOM already exists, while retaining the event for client navigation.
  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>
