---
/**
 * /admin/marking — Phase 1 project marking: the groups (numbers from the proposal item), the marking form with
 * the grading assistant, the upload (Phase1_Marking.xlsx, one TA's sheet, or a CSV), each TA's own sheet to fill
 * offline, the marking load, the summary with marking consistency, the merged Excel download and Publish.
 * Rules: src/lib/marking/* · API: src/pages/api/admin/marking · browser: src/scripts/marking.ts
 */
import Base from '@/layouts/Base.astro';
import AdminShell from '@/components/admin/AdminShell.astro';
import { canManageSubmissions } from '@/lib/accounts/labscope';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');
if (!(await canManageSubmissions(Astro.cookies))) return Astro.redirect('/admin', 303);
---
<Base title="Marking" noindex>
<AdminShell active="marking">
  <section class="mk-shell container" data-mk>
    <header class="mk-top">
      <div>
        <p class="mk-k mono">Mobile Development · Project · Phase 1 (30 marks)</p>
        <h1>Marking</h1>
        <p class="muted" data-mk-role>Loading…</p>
      </div>
      <div class="mk-actions">
        <a class="btn btn-ghost btn-sm" href="/api/admin/marking/export">Download Excel ↓</a>
        <button class="btn btn-primary btn-sm" type="button" data-mk-publish hidden aria-pressed="false">Publish marks to students</button>
      </div>
    </header>
    <div class="mk-bar">
      <span data-mk-source></span>
      <span class="mk-pub" data-mk-pubnote></span>
    </div>
    <p class="mk-msg" role="status" data-mk-msg></p>

    <div class="mk-tabs" role="tablist" aria-label="Marking">
      <button type="button" role="tab" aria-selected="true" data-mk-tab="marks">Marks</button>
      <button type="button" role="tab" aria-selected="false" data-mk-tab="load">Marking load</button>
      <button type="button" role="tab" aria-selected="false" data-mk-tab="summary">Summary</button>
    </div>

    <div role="tabpanel" data-mk-panel="marks" class="mk-panel">
      <div class="mk-upload">
        <div class="mk-upload-t">
          <b>Upload your marks: Excel or CSV</b>
          <p class="small muted">Phase1_Marking.xlsx, one TA’s sheet, or a CSV with a Group column and the criteria columns. You see what changes before anything is saved. Every TA can import any group, empty cells keep the marks already saved, and each import records who made it.</p>
          <p class="small" data-mk-mine-dl hidden></p>
          <details class="mk-csvhelp small">
            <summary>CSV format</summary>
            <p class="muted">First row: the column names below (any order, commas or semicolons, decimal points or commas). Then one row per group. <b>Group</b> can be 12 or G12; leave a cell empty if you have not marked it yet.</p>
            <code class="mk-code">Group,Actors,Correct logic,Mapping to functional reqs,Functional reqs included,Correct &amp; logical flow,Screens,Pattern selected,Correct implementation in structure,Reasoning,Comments</code>
            <button type="button" class="btn btn-ghost btn-sm" data-mk-copy>Copy the header</button>
          </details>
        </div>
        <label class="btn btn-primary btn-sm mk-file">Choose a file<input type="file" accept=".xlsx,.csv,.tsv,.txt,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" data-mk-file /></label>
      </div>
      <div class="mk-preview" data-mk-preview hidden></div>

      <details class="mk-builds" data-mk-builds>
        <summary data-builds-sum>App builds</summary>
        <p class="small muted">Each group's app runs beside the marking form: a real web build made from the GitHub repo in its hand-in (or the app files in its ZIP). <b>Every hand-in is built automatically every hour</b> (on GitHub, in a Docker box), now and for anything handed in later, so a new app shows within about an hour. Student code runs only inside the Docker box.</p>
        <p class="small muted">To build one right away, or again, on your own computer with Docker:</p>
        <ol class="mk-builds-steps small">
          <li><button type="button" class="btn btn-ghost btn-sm" data-builds-list>Download the build list</button></li>
          <li>On a computer with Docker, in the labverse folder: <code class="mk-code">npm run previews -- build-list.json</code> It builds only new or changed apps (about 3–6 minutes each).</li>
          <li><label class="btn btn-primary btn-sm mk-file">Upload the builds (.zip)<input type="file" accept=".zip,application/zip" multiple data-builds-file /></label></li>
        </ol>
        <p class="mk-msg" role="status" data-builds-msg></p>
      </details>

      <div class="mk-tools">
        <div class="mk-chips" role="group" aria-label="Show groups">
          <button type="button" class="mk-chip" aria-pressed="false" data-mk-filter="mine" hidden>My groups <span></span></button>
          <button type="button" class="mk-chip" aria-pressed="true" data-mk-filter="all">All <span></span></button>
          <button type="button" class="mk-chip" aria-pressed="false" data-mk-filter="todo">Not marked <span></span></button>
          <button type="button" class="mk-chip" aria-pressed="false" data-mk-filter="done">Marked <span></span></button>
        </div>
        <input class="input mk-search" type="search" placeholder="Search group, TA, student, ID or idea" data-mk-search aria-label="Search groups" />
      </div>
      <div class="mk-tablewrap">
        <table class="mk-table mk-groups">
          <thead><tr><th scope="col">Group</th><th scope="col">TA</th><th scope="col">Members</th><th scope="col">Idea</th><th scope="col">/30</th><th scope="col">Grade</th><th scope="col">Status</th><th scope="col" title="Call the group to discuss their project: the students see only the call, no marks and no feedback">AI</th><th scope="col"><span class="sr-only">Open</span></th></tr></thead>
          <tbody data-mk-rows><tr><td colspan="9" class="faint">Loading groups…</td></tr></tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" data-mk-panel="load" class="mk-panel" hidden>
      <div data-mk-load></div>
    </div>

    <div role="tabpanel" data-mk-panel="summary" class="mk-panel" hidden>
      <div data-mk-summary></div>
    </div>

    <dialog class="mk-dlg" data-mk-dlg aria-labelledby="mk-d-title">
      <div class="mk-d-head">
        <div>
          <h2 id="mk-d-title" data-mk-d-title></h2>
          <p class="small muted" data-mk-d-meta></p>
        </div>
        <div class="mk-d-tools">
          <button type="button" class="btn btn-ghost btn-sm mk-ai-d" data-mk-ai-d aria-pressed="false" hidden>AI: call to discuss</button>
          <button type="button" class="btn btn-ghost btn-sm" data-mk-proj-toggle aria-pressed="true" title="Show or hide the group's app and report">Project</button>
          <button type="button" class="mk-x" data-mk-close aria-label="Close">✕</button>
        </div>
      </div>
      <div class="mk-d-body">
        <div class="mk-d-form">
          <p class="mk-draft small" data-mk-draft hidden></p>
          <div class="mk-formtools"><button type="button" class="mk-link" data-mk-full>Fill the empty marks with full marks</button></div>
          <div data-mk-form></div>
          <p class="mk-total" data-mk-total></p>
          <label class="mk-comment"><span>Comments <span class="mono faint" data-mk-count></span></span><textarea class="input" rows="7" data-mk-comment placeholder="What to fix next phase. The assistant adds a ready sentence here for each finding that costs marks."></textarea></label>
          <ul class="mk-warn" data-mk-warn></ul>
          <p class="mk-flag" data-mk-ro hidden>Read only: only TAs and admins can mark.</p>
          <div class="mk-actions">
            <button type="button" class="btn btn-primary btn-sm" data-mk-save>Save marks</button>
            <button type="button" class="btn btn-ghost btn-sm" data-mk-save-next>Save &amp; next group</button>
            <button type="button" class="btn btn-ghost btn-sm" data-mk-close>Close</button>
            <span class="mk-d-msg small" role="status" data-mk-d-msg></span>
          </div>
          <p class="small faint" data-mk-hint>Ctrl + Enter saves · Ctrl + Shift + Enter saves and opens the next group. Unsaved changes stay in this browser as a draft.</p>
        </div>
        <aside class="mk-assist-wrap" aria-label="Grading assistant" data-mk-aside>
          <p class="mk-assist-h">Grading assistant</p>
          <p class="small muted">Answer what you see for each mark: it suggests the mark from the brief’s rule and writes the comment sentences. You can change both.</p>
          <div class="mk-assist" data-mk-assist></div>
        </aside>
        <section class="mk-proj" data-mk-proj aria-label="The group's project: app, report and hand-in"></section>
      </div>
    </dialog>
  </section>
</AdminShell>
</Base>

<script>
  import { initMarking } from '@/scripts/marking';
  const root = document.querySelector<HTMLElement>('[data-mk]');
  if (root && !root.dataset.wired) {
    root.dataset.wired = '1';
    initMarking(root);
  }
</script>

<style is:global>
  .mk-shell { min-height: 85dvh; padding-top: calc(var(--nav-h) + 44px); padding-bottom: 100px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-content: start; }
  .mk-k { color: var(--accent-text); font-size: 12px; }
  .mk-top { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .mk-top h1 { font-size: var(--fs-xl); letter-spacing: -.04em; margin-top: 3px; }
  .mk-top p.muted { max-width: 70ch; margin-top: 4px; }
  .mk-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .mk-bar { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; font-size: 14px; color: var(--text-2); }
  .mk-src { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .mk-select { height: 36px; padding: 0 10px; max-width: 100%; }
  .mk-msg { min-height: 20px; margin: 0; font-size: 14px; color: var(--text-2); }
  .mk-msg[data-tone='ok'] { color: var(--ok); }
  .mk-msg[data-tone='err'] { color: var(--danger); }

  .mk-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); }
  .mk-tabs button { padding: 10px 14px; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--text-2); font: 600 14px var(--font-body); cursor: pointer; }
  .mk-tabs button[aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent-text); }
  .mk-tabs button:focus-visible { outline: 2px solid var(--accent-text); outline-offset: -2px; }
  .mk-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }

  .mk-upload { display: flex; justify-content: space-between; align-items: center; gap: 12px 20px; flex-wrap: wrap; padding: 14px 16px; border: 1px dashed var(--line-2); border-radius: var(--r-lg); background: var(--surface); transition: border-color .15s, background-color .15s; }
  .mk-upload[data-over] { border-color: var(--accent-text); background: var(--accent-soft); }
  .mk-upload-t { display: grid; gap: 6px; min-width: 0; flex: 1 1 420px; }
  .mk-upload p { margin: 0; max-width: 75ch; }
  .mk-csvhelp summary { cursor: pointer; color: var(--accent-text); font-weight: 600; width: max-content; }
  .mk-csvhelp[open] { display: grid; gap: 8px; justify-items: start; }
  .mk-csvhelp p { margin-top: 6px; }
  .mk-code { display: block; max-width: 100%; padding: 8px 10px; border-radius: 8px; background: var(--surface-2); font: 12px/1.5 var(--font-mono); overflow-wrap: anywhere; user-select: all; }
  .mk-file { position: relative; overflow: hidden; }
  .mk-file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .mk-file:focus-within { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .mk-preview { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; padding: 14px 16px; border: 1px solid color-mix(in oklab, var(--accent-text) 40%, var(--line)); border-radius: var(--r-lg); background: var(--surface); }
  .mk-preview p { margin: 0; }
  .mk-loadchk { display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--text); }

  .mk-tools { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .mk-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .mk-chip { padding: 6px 12px; border: 1px solid var(--line-2); border-radius: 999px; background: none; color: var(--text-2); font: 500 12.5px var(--font-body); cursor: pointer; }
  .mk-chip span { color: var(--text-3); font-family: var(--font-mono); font-size: 11px; margin-left: 2px; }
  .mk-chip[aria-pressed='true'] { border-color: var(--accent-text); background: var(--accent-soft); color: var(--accent-text); }
  .mk-search { max-width: 320px; height: 40px; padding: 0 14px; }

  .mk-tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .mk-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .mk-table th, .mk-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .mk-table thead th { font: 600 11px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); background: var(--surface-2); }
  .mk-table tbody tr:last-child > * { border-bottom: 0; }
  .mk-table .input { height: 36px; min-width: 120px; }
  .mk-groups { min-width: 900px; }
  .mk-members { max-width: 260px; color: var(--text-2); }
  .mk-idea { max-width: 220px; }
  .mk-grade { display: inline-grid; place-items: center; min-width: 26px; height: 22px; padding: 0 6px; border-radius: 6px; font: 700 12px var(--font-mono); background: var(--surface-2); color: var(--text); }
  .mk-grade[data-g='A'] { background: color-mix(in oklab, var(--ok) 22%, transparent); }
  .mk-grade[data-g='B'] { background: color-mix(in oklab, var(--info) 22%, transparent); }
  .mk-grade[data-g='C'] { background: color-mix(in oklab, var(--warn) 22%, transparent); }
  .mk-grade[data-g='D'], .mk-grade[data-g='F'] { background: color-mix(in oklab, var(--danger) 22%, transparent); }
  .mk-flag { display: inline-block; margin: 0; padding: 2px 8px; border-radius: 999px; font-size: 12.5px; color: var(--text-2); background: var(--surface-2); }
  .mk-flag.ok { color: var(--ok); background: color-mix(in oklab, var(--ok) 12%, transparent); }
  .mk-flag.warn { color: var(--text); background: color-mix(in oklab, var(--warn) 18%, transparent); }
  .mk-flag.draft { color: var(--text); background: color-mix(in oklab, var(--info) 16%, transparent); }
  .mk-flag.ai { color: var(--text); background: color-mix(in oklab, var(--danger) 16%, transparent); font-weight: 600; }
  /* the AI button: calls the group in to discuss their project (students then see only the call) */
  .mk-ai { min-width: 44px; min-height: 32px; padding: 4px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text-2); font: 600 12.5px/1 var(--font-mono, ui-monospace, monospace); letter-spacing: .04em; cursor: pointer; }
  .mk-ai:hover { border-color: color-mix(in oklab, var(--danger) 55%, var(--line)); color: var(--text); }
  .mk-ai:focus-visible, .mk-ai-d:focus-visible { outline: 2px solid var(--focus, var(--accent)); outline-offset: 2px; }
  .mk-ai[aria-pressed="true"], .mk-ai-d[aria-pressed="true"] { border-color: var(--danger); background: color-mix(in oklab, var(--danger) 16%, transparent); color: var(--text); }
  .mk-note { margin: 0; font-size: 14px; color: var(--text-2); max-width: 80ch; }
  .mk-dl { white-space: nowrap; font-size: 13px; }
  .mk-loadt { min-width: 860px; }
  .mk-loadt td:nth-child(1) .input { width: 120px; min-width: 0; }
  .mk-loadt td:nth-child(2) .mk-select { width: 210px; }
  .mk-loadt td:nth-child(3) { width: 40%; }
  .mk-loadt td:nth-child(3) .input { width: 100%; min-width: 220px; }
  .mk-loadt td:nth-child(5) { white-space: nowrap; }
  .mk-loadt .mk-meter { width: 60px; }
  .mk-h2 { margin: 10px 0 0; font-size: 1.1rem; }
  .mk-cons td.mk-off { background: color-mix(in oklab, var(--warn) 16%, transparent); font-weight: 600; }
  .mk-warn-box { padding: 10px 12px 10px 28px; border-radius: var(--r-md); background: color-mix(in oklab, var(--warn) 10%, transparent); }
  .mk-meter { display: inline-block; width: 90px; height: 6px; margin-right: 8px; border-radius: 99px; background: var(--line); overflow: hidden; vertical-align: middle; }
  .mk-meter i { display: block; height: 100%; width: var(--w); background: var(--accent); border-radius: inherit; transition: width .3s var(--ease-out); }
  .mk-numbers summary { cursor: pointer; font-weight: 600; padding: 6px 0; }
  /* phones: each group is a card (a 900px table would widen the whole page) */
  @media (max-width: 720px) {
    .mk-groups { min-width: 0; display: block; }
    .mk-groups thead { display: none; }
    .mk-groups tbody { display: grid; }
    .mk-groups tbody tr { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 6px 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
    .mk-groups tbody tr > * { padding: 0; border: 0; }
    .mk-groups tbody th { font-size: 1.15rem; }
    .mk-groups .mk-members { grid-column: 1 / -1; grid-row: 2; max-width: none; }
    .mk-groups .mk-idea { display: none; }
    .mk-groups td:nth-child(7) { grid-column: 1 / 3; grid-row: 3; }
    .mk-groups td:last-child { grid-column: 3 / -1; grid-row: 3; justify-self: end; }
  }

  .mk-kpis { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .mk-kpi { padding: 16px 18px; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: var(--surface); }
  .mk-kpi span { font: 500 10.5px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  .mk-kpi b { display: block; margin: 6px 0 8px; font: 600 32px/1 var(--font-display); letter-spacing: -.04em; }
  .mk-kpi small { font-size: 15px; color: var(--text-3); }
  .mk-kpi .mk-meter { width: 100%; }
  .mk-grades { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; align-items: end; height: 150px; padding: 14px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .mk-gbar { display: grid; grid-template-rows: auto 1fr auto; justify-items: center; gap: 6px; height: 100%; }
  .mk-gbar i { align-self: end; width: 60%; height: var(--h); min-height: 2px; border-radius: 6px 6px 2px 2px; background: var(--accent); transition: height .4s var(--ease-out); }

  .mk-dlg { width: min(1100px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 0; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: var(--bg); color: var(--text); }
  .mk-dlg::backdrop { background: rgb(0 0 0 / .55); }
  .mk-d-tools { display: flex; align-items: flex-start; gap: 8px; flex: none; }
  .mk-dlg[data-proj='on'] { width: min(1720px, calc(100vw - 16px)); max-height: calc(100dvh - 16px); }
  .mk-dlg:not([data-proj='on']) .mk-proj, .mk-dlg[data-proj='on'] .mk-assist-wrap { display: none; }
  @media (min-width: 1100px) {
    .mk-dlg[data-proj='on'] .mk-d-body { grid-template-columns: minmax(0, 1fr) minmax(420px, 1.05fr); }
    .mk-dlg[data-proj='on'] .mk-proj { position: sticky; top: calc(var(--mk-head, 90px) + 12px); height: calc(100dvh - var(--mk-head, 90px) - 60px); align-self: start; }
  }
  .mk-proj { display: grid; grid-template-rows: auto minmax(0, 1fr); min-height: 620px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); overflow: hidden; }
  .mk-proj-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 6px 8px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  .mk-proj-tabs { display: flex; gap: 2px; }
  .mk-proj-tabs button { padding: 8px 12px; border: 0; border-radius: 8px; background: none; color: var(--text-2); font: 600 13px var(--font-body); cursor: pointer; }
  .mk-proj-tabs button[aria-selected='true'] { background: var(--bg); color: var(--text); box-shadow: 0 0 0 1px var(--line-2); }
  .mk-proj-tabs button:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 1px; }
  .mk-proj-body { display: grid; gap: 10px; align-content: start; padding: 12px; overflow: auto; min-height: 0; }
  .mk-proj-note { margin: 0; color: var(--text-2); font-size: 14px; }
  .mk-proj-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14px; }
  .mk-proj-repo { color: var(--accent-text); font-weight: 600; overflow-wrap: anywhere; }
  .mk-proj-repo-form { display: flex; gap: 8px; flex-wrap: wrap; }
  .mk-proj-repo-form .input { flex: 1 1 260px; height: 36px; }
  .mk-proj-err { color: var(--danger); margin: 0; flex-basis: 100%; }
  .mk-phone-wrap { display: grid; justify-items: center; }
  .mk-phone { height: min(844px, max(520px, calc(100dvh - var(--mk-head, 90px) - 240px))); aspect-ratio: 390 / 844; max-width: 100%; border: 10px solid #111316; border-radius: 38px; overflow: hidden; background: #fff; box-shadow: 0 18px 40px rgb(0 0 0 / .35), 0 0 0 1px var(--line-2); }
  .mk-phone iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
  .mk-proj-cap { margin: 0; color: var(--text-3); text-align: center; }
  .mk-proj-empty { padding: 16px; border: 1px dashed var(--line-2); border-radius: var(--r-md); }
  .mk-proj-empty p { margin: 6px 0 0; color: var(--text-2); }
  .mk-proj-pages canvas { display: block; width: 100%; height: auto; margin-bottom: 10px; border-radius: 6px; background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .mk-proj-docx { display: grid; gap: 8px; padding: 14px; border-radius: 8px; background: #fff; color: #111; font-size: 13.5px; line-height: 1.5; }
  .mk-proj-docx p { margin: 0; }
  .mk-proj-docx img { max-width: 100%; height: auto; border: 1px solid #ddd; }
  .mk-proj-files { margin: 0; padding-left: 18px; font-size: 12px; columns: 2 260px; }
  .mk-builds { padding: 12px 16px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .mk-builds summary { cursor: pointer; font-weight: 600; }
  .mk-builds p { margin: 8px 0 0; max-width: 80ch; }
  .mk-builds-steps { display: grid; gap: 8px; margin: 10px 0 0; padding-left: 20px; }
  .mk-builds-steps .mk-code { display: inline-block; margin: 4px 0; }
