---
/**
 * Students' "forgot password" requests. A TA checks it is really the student (in the lab, or by a message from
 * their university email) and approves: the student's own page then asks for a new password, and the TA also
 * gets a one-time link to send them. API: src/pages/api/admin/password-resets.ts.
 */
import Base from '@/layouts/Base.astro';
import AdminShell from '@/components/admin/AdminShell.astro';
import { access } from '@/lib/accounts/access';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

const a = await access(Astro.cookies);
if (!a.user && !a.master) return Astro.redirect('/login?next=/admin/password-resets', 303);
const teaching = a.master || (a.user !== null && a.user.role !== 'student') || Object.keys(a.who.modules).length > 0;
if (!teaching) return Astro.redirect('/admin', 303);
---
<Base title="Password requests" noindex>
  <AdminShell active="resets">
    <section class="pr container" data-pr>
      <header class="pr-head">
        <p class="pr-k mono">Workspace · accounts</p>
        <h1>Password requests</h1>
        <p class="muted">Students who forgot their password ask here from the sign-in page. Check it’s really them — in the lab, or from their university email — then approve. Their page lets them choose a new password straight away.</p>
      </header>

      <p class="pr-msg" role="status" data-pr-msg></p>
      <div class="pr-section">
        <h2>Waiting <span class="pr-n mono" data-pr-count>0</span></h2>
        <div class="pr-list" data-pr-pending><p class="muted">Loading…</p></div>
      </div>
      <div class="pr-section">
        <h2>Last 7 days</h2>
        <div class="pr-list" data-pr-done></div>
      </div>
    </section>
  </AdminShell>
</Base>

<style is:global>
  .pr { min-height: 80dvh; padding-top: calc(var(--nav-h) + 44px); padding-bottom: 100px; display: grid; gap: 22px; align-content: start; }
  .pr-k { font-size: 12px; color: var(--accent-text); }
  .pr-head h1 { font-size: var(--fs-xl); letter-spacing: -.04em; margin-top: 4px; }
  .pr-head p { max-width: 70ch; margin-top: 6px; }
  .pr-section { display: grid; gap: 12px; }
  .pr-section h2 { display: flex; align-items: center; gap: 10px; font-size: var(--fs-lg); }
  .pr-n { min-width: 26px; padding: 2px 8px; border-radius: 999px; background: var(--surface-2); font-size: 13px; text-align: center; }
  .pr-n.hot { background: var(--danger); color: #fff; }
  .pr-list { display: grid; gap: 10px; }
  .pr-card { display: grid; gap: 12px; padding: 16px 18px; border-radius: var(--r-lg); border: 1px solid var(--line-2); background: var(--surface); }
  .pr-card.pending { border-color: color-mix(in oklab, var(--warn) 55%, var(--line-2)); }
  .pr-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; align-items: start; }
  .pr-who b { display: block; font-size: 16px; }
  .pr-who span { display: block; margin-top: 2px; font: 12.5px var(--font-mono); color: var(--text-2); overflow-wrap: anywhere; }
  .pr-when { font-size: 13px; color: var(--text-3); }
  .pr-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .pr-chip { padding: 3px 10px; border-radius: 999px; font: 600 12px var(--font-mono); background: var(--surface-2); color: var(--text-2); }
  .pr-chip.approved, .pr-chip.done { background: var(--accent-soft); color: var(--accent-text); }
  .pr-chip.rejected { background: color-mix(in oklab, var(--danger) 14%, transparent); color: var(--danger); }
  .pr-link { display: grid; gap: 8px; padding: 12px 14px; border-radius: 12px; background: var(--accent-soft); font-size: 14px; }
  .pr-link code { display: block; padding: 8px 10px; border-radius: 8px; background: var(--surface); font-size: 12px; overflow-wrap: anywhere; }
  .pr-msg { min-height: 20px; font-size: 14px; color: var(--accent-text); }
  .pr-msg.err { color: var(--danger); }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  type Req = { id: string; name: string; email: string; student_id: string; status: string; created_at: string; decided_at: string | null; decided_by: string | null; active: boolean };
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const ago = (iso: string) => {
    const m = Math.round((Date.now() - Date.parse(iso)) / 60000);
    return m < 1 ? 'just now' : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.round(m / 60)} h ago` : new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
  };
  const LABEL: Record<string, string> = { approved: 'Approved', rejected: 'Declined', done: 'Password changed', replaced: 'Replaced by a newer request', pending: 'Waiting' };

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-pr]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const msg = root.querySelector<HTMLElement>('[data-pr-msg]')!;
    const say = (t: string, err = false) => { msg.className = `pr-msg ${err ? 'err' : ''}`; msg.textContent = t; };
    const links = new Map<string, string>();

    const card = (r: Req) => `<article class="pr-card ${r.status}" data-id="${esc(r.id)}">
      <div class="pr-top">
        <div class="pr-who"><b>${esc(r.name)}</b><span>${esc(r.email)} · ID ${esc(r.student_id)}</span></div>
        <span class="pr-when">${r.status === 'pending' ? `asked ${ago(r.created_at)}` : `<span class="pr-chip ${r.status}">${LABEL[r.status] ?? r.status}</span> ${r.decided_by ? `by ${esc(r.decided_by)} · ` : ''}${ago(r.decided_at ?? r.created_at)}`}</span>
      </div>
      ${r.status === 'pending' ? `<div class="pr-acts">
        <button type="button" class="btn btn-primary btn-sm" data-act="approve">Approve</button>
        <button type="button" class="btn btn-ghost btn-sm" data-act="reject">Decline</button>
      </div>` : ''}
      ${links.has(r.id) ? `<div class="pr-link"><span>The student’s page now asks for a new password. If they’re not on that device, send them this one-time link (24 hours):</span><code>${esc(links.get(r.id)!)}</code>
        <span class="pr-acts"><button type="button" class="btn btn-ghost btn-sm" data-copy="${esc(r.id)}">Copy link</button><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="https://wa.me/?text=${encodeURIComponent(`Your BUENOVA password reset was approved. Open this link to choose a new password (it works once, for 24 hours): ${links.get(r.id)}`)}">Share on WhatsApp ↗</a></span></div>` : ''}
    </article>`;

    const load = async () => {
      const r = await fetch('/api/admin/password-resets', { cache: 'no-store' });
      if (r.status === 401) return location.reload();
      const d = await r.json().catch(() => ({ requests: [] }));
      if (!r.ok) return say(d.error ?? 'Could not load the requests.', true);
      const reqs = d.requests as Req[];
      const pending = reqs.filter((x) => x.status === 'pending');
      const done = reqs.filter((x) => x.status !== 'pending');
      const count = root.querySelector<HTMLElement>('[data-pr-count]')!;
      count.textContent = String(pending.length);
      count.classList.toggle('hot', pending.length > 0);
      root.querySelector('[data-pr-pending]')!.innerHTML = pending.length ? pending.map(card).join('') : '<p class="muted">No one is waiting. New requests appear here by themselves.</p>';
      root.querySelector('[data-pr-done]')!.innerHTML = done.length ? done.map(card).join('') : '<p class="muted">Nothing yet.</p>';
    };

    root.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const copy = t.closest<HTMLElement>('[data-copy]');
      if (copy) {
        try { await navigator.clipboard.writeText(links.get(copy.dataset.copy!) ?? ''); say('Link copied.'); } catch { say('Select the link and copy it.', true); }
        return;
      }
      const btn = t.closest<HTMLButtonElement>('[data-act]');
      const id = btn?.closest<HTMLElement>('[data-id]')?.dataset.id;
      if (!btn || !id) return;
      btn.disabled = true;
      const r = await fetch('/api/admin/password-resets', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id, action: btn.dataset.act }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { btn.disabled = false; return say(d.error ?? 'Could not save.', true); }
      if (d.link) links.set(id, d.link);
      say(btn.dataset.act === 'approve' ? 'Approved. The student can now choose a new password.' : 'Declined. The student sees it on their page.');
      await load();
      document.dispatchEvent(new Event('buenova:resets-changed'));
    });

    void load();
    const timer = window.setInterval(() => { if (!root.isConnected) clearInterval(timer); else if (document.visibilityState === 'visible') void load(); }, 20_000);
  });
</script>
